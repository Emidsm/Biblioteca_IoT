        "type": "function",
        "z": "b7e1ba8308c39b87",
        "name": "Script de respaldo",
        "func": "\nconst tipo = msg.payload.tipo || 'manual';\nconst ahora = new Date();\nconst timestamp = ahora.toISOString()\n    .replace(/[:.]/g, '-')\n    .replace('T', '_')\n    .substring(0, 19);\n\nconst DB_PATH    = env.get('SQLITE_DB_PATH') || '/data/biblioteca/biblioteca.db';\nconst BACKUP_DIR = env.get('BACKUP_DIR')     || '/data/backups';\nconst MAX_BACKUPS = parseInt(env.get('MAX_BACKUPS') || '30');\n\nconst backupFile = `${BACKUP_DIR}/biblioteca_${tipo}_${timestamp}.db`;\n\nmsg.payload = [\n    `mkdir -p ${BACKUP_DIR}`,\n    `sqlite3 ${DB_PATH} \".timeout 5000\" \".backup ${backupFile}\"`,\n    `gzip -9 ${backupFile}`,\n    `ls -t ${BACKUP_DIR}/biblioteca_*.db.gz | tail -n +${MAX_BACKUPS + 1} | xargs -r rm --`\n].join(' && ');\n\nmsg.backup_meta = { tipo, timestamp, archivo: backupFile + '.gz' };\nnode.log(`Iniciando backup ${tipo}: ${backupFile}.gz`);\nreturn msg;\n",
