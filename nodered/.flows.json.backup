    {
        "id": "4a3cb88bbd4f8b72",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Insert Usuario",
        "func": "\nconst d = msg.payload;\nmsg.topic = `INSERT INTO usuarios (nombre, apellido, email, rfid_tag, tipo_usuario, max_prestamos, fecha_vigencia, activo) VALUES ('${d.nombre}', '${d.apellido}', '${d.email}', '${d.rfid_tag}', '${d.tipo_usuario}', ${d.max_prestamos}, ${d.fecha_vigencia ? `'${d.fecha_vigencia}'` : 'NULL'}, 1);`;\nreturn msg;\n",
