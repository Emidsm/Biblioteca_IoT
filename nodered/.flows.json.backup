        "func": "\nif (env.get('NODE_ENV') !== 'production') {\n    node.log(`[AUDIT] ${msg.payload && msg.payload.accion || 'evento'}: ${JSON.stringify(msg.payload)}`);\n}\nreturn null;\n",
