    },
    {
        "id": "tab_biblioteca_iot",
        "type": "tab",
        "label": "Biblioteca IoT - Principal",
        "disabled": false,
        "info": "Flujo principal del sistema de biblioteca IoT.\nManeja RFID, QR, préstamos, devoluciones y dashboard."
    },
    {
        "id": "tab_backup",
        "type": "tab",
        "label": "Respaldos Automáticos",
        "disabled": false,
        "info": "Cron de respaldo periódico del archivo SQLite."
    },
    {
        "id": "sqlite_config",
        "type": "sqlitedb",
        "z": "tab_biblioteca_iot",
        "db": "/data/biblioteca/biblioteca.db",
        "mode": "RWC"
    },
    {
        "id": "mqtt_broker_config",
        "type": "mqtt-broker",
        "name": "Mosquitto Local",
        "broker": "${MQTT_HOST}",
        "port": "${MQTT_PORT}",
        "clientid": "nodered-biblioteca",
        "usetls": false,
        "compatmode": false,
        "keepalive": "60",
        "cleansession": true,
        "birthTopic": "biblioteca/sistema/status",
        "birthQos": "1",
        "birthPayload": "{\"status\":\"online\",\"ts\":\"{{{timestamp}}}\"}",
        "closeTopic": "biblioteca/sistema/status",
        "closeQos": "1",
        "closePayload": "{\"status\":\"offline\"}"
    },
    {
        "id": "http_rfid_scan",
        "type": "http in",
        "z": "tab_biblioteca_iot",
        "name": "POST /api/rfid/scan",
        "url": "/api/rfid/scan",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 140,
        "y": 80,
        "wires": [
            [
                "validate_apikey"
            ]
        ]
    },
    {
        "id": "mqtt_rfid_scan",
        "type": "mqtt in",
        "z": "tab_biblioteca_iot",
        "name": "MQTT biblioteca/rfid/scan",
        "topic": "biblioteca/rfid/scan",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker_config",
        "inputs": 0,
        "x": 110,
        "y": 200,
        "wires": [
            [
                "fn_wrap_mqtt_rfid"
            ]
        ]
    },
    {
        "id": "fn_wrap_mqtt_rfid",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Wrap MQTT → formato HTTP",
        "func": "// Normaliza el payload MQTT al mismo formato que HTTP\n// para reutilizar el mismo flujo de validación\nmsg.req = { headers: { 'x-api-key': env.get('BIBLIOTECA_API_KEY') } };\nmsg.res = null; // No hay respuesta HTTP en MQTT\nmsg._mqtt = true;\nreturn msg;",
        "outputs": 1,
        "x": 360,
        "y": 130,
        "wires": [
            [
                "validate_apikey"
            ]
        ]
    },
    {
        "id": "validate_apikey",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Validar API Key",
        "func": "// -------------------------------------------------------\n// Seguridad: Verifica el header x-api-key contra\n// la variable de entorno BIBLIOTECA_API_KEY\n// NUNCA hardcodear la API key en el flujo\n// -------------------------------------------------------\nconst expectedKey = env.get('BIBLIOTECA_API_KEY');\nconst receivedKey = (msg.req && msg.req.headers)\n    ? msg.req.headers['x-api-key']\n    : null;\n\nif (!expectedKey) {\n    node.error('BIBLIOTECA_API_KEY no configurada en variables de entorno');\n    msg.payload = { ok: false, error: 'Configuración del servidor incompleta' };\n    msg.statusCode = 500;\n    return [null, msg];\n}\n\nif (receivedKey !== expectedKey) {\n    node.warn(`API Key inválida desde ${msg.req && msg.req.ip}`);\n    msg.payload = { ok: false, error: 'No autorizado' };\n    msg.statusCode = 401;\n    return [null, msg];\n}\n\n// Extraer el payload real\nmsg.scanData = (typeof msg.payload === 'string')\n    ? JSON.parse(msg.payload)\n    : msg.payload;\n\nreturn [msg, null];",
        "outputs": 2,
        "x": 580,
        "y": 100,
        "wires": [
            [
                "route_scan_type"
            ],
            [
                "http_response_error"
            ]
        ]
    },
    {
        "id": "route_scan_type",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Enrutar por tipo de escaneo",
        "func": "// -------------------------------------------------------\n// Determina si el escaneo es:\n// - rfid: identificación de usuario\n// - qr: identificación de libro\n// - prestamo: acción completa (rfid + qr juntos)\n// - devolucion: devolución de libro\n// -------------------------------------------------------\nconst scan = msg.scanData || {};\n\n// Validación básica de estructura\nif (!scan.tipo) {\n    msg.payload = { ok: false, error: 'Payload inválido: falta campo tipo' };\n    msg.statusCode = 400;\n    return [null, null, null, msg];\n}\n\nmsg.origen = scan.origen || 'desconocido'; // 'rfid', 'qr', 'api'\n\nswitch (scan.tipo) {\n    case 'identificar_usuario':\n        msg.rfid_tag = scan.rfid_tag;\n        return [msg, null, null, null];\n    case 'prestamo':\n        msg.rfid_tag = scan.rfid_tag;\n        msg.qr_codigo = scan.qr_codigo;\n        return [null, msg, null, null];\n    case 'devolucion':\n        msg.rfid_tag = scan.rfid_tag;\n        msg.qr_codigo = scan.qr_codigo;\n        return [null, null, msg, null];\n    default:\n        msg.payload = { ok: false, error: `Tipo desconocido: ${scan.tipo}` };\n        msg.statusCode = 400;\n        return [null, null, null, msg];\n}",
        "outputs": 4,
        "x": 820,
        "y": 100,
        "wires": [
            [
                "fn_identificar_usuario"
            ],
            [
                "fn_procesar_prestamo"
            ],
            [
                "fn_procesar_devolucion"
            ],
            [
                "http_response_error"
            ]
        ]
    },
    {
        "id": "fn_identificar_usuario",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Preparar consulta usuario",
        "func": "// Validación del tag RFID\nconst tag = msg.rfid_tag;\n\nif (!tag || typeof tag !== 'string' || tag.trim() === '') {\n    msg.payload = { ok: false, error: 'Tag RFID no válido o vacío' };\n    msg.statusCode = 400;\n    return [null, msg];\n}\n\n// Sanitizar: solo alfanumérico (formato UID RFID)\nif (!/^[A-Fa-f0-9]{4,16}$/.test(tag.trim())) {\n    msg.payload = { ok: false, error: 'Formato de tag RFID inválido' };\n    msg.statusCode = 422;\n    return [null, msg];\n}\n\nmsg.topic = `SELECT id, nombre, apellido, email, tipo_usuario, activo,\n    max_prestamos, fecha_vigencia,\n    (SELECT COUNT(*) FROM prestamos\n     WHERE usuario_id = u.id AND estado = 'activo') AS prestamos_actuales\nFROM usuarios u\nWHERE rfid_tag = ?`;\n\nmsg.params = [tag.trim().toUpperCase()];\nreturn [msg, null];",
        "outputs": 2,
        "x": 1060,
        "y": 60,
        "wires": [
            [
                "sqlite_query_usuario"
            ],
            [
                "http_response_error"
            ]
        ]
    },
    {
        "id": "sqlite_query_usuario",
        "type": "sqlite",
        "z": "tab_biblioteca_iot",
        "mydb": "sqlite_config",
        "sqlquery": "prepared",
        "sql": "",
        "name": "DB: Buscar usuario por RFID",
        "x": 1300,
        "y": 60,
        "wires": [
            [
                "fn_respuesta_usuario"
            ]
        ]
    },
    {
        "id": "fn_respuesta_usuario",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Procesar respuesta usuario",
        "func": "const rows = msg.payload;\n\n// Usuario no encontrado\nif (!rows || rows.length === 0) {\n    // Log de intento fallido\n    node.warn(`RFID no registrado: ${msg.rfid_tag}`);\n    msg.payload = {\n        ok: false,\n        error: 'TAG_NO_REGISTRADO',\n        mensaje: 'Tag RFID no encontrado en el sistema',\n        rfid_tag: msg.rfid_tag\n    };\n    msg.statusCode = 404;\n    msg.uiEvent = { tipo: 'error', codigo: 'TAG_NO_REGISTRADO', rfid: msg.rfid_tag };\n    return [msg, null];\n}\n\nconst usuario = rows[0];\n\n// Usuario inactivo\nif (!usuario.activo) {\n    msg.payload = {\n        ok: false,\n        error: 'USUARIO_INACTIVO',\n        mensaje: `El usuario ${usuario.nombre} ${usuario.apellido} está inactivo`,\n        usuario: { id: usuario.id, nombre: `${usuario.nombre} ${usuario.apellido}` }\n    };\n    msg.statusCode = 403;\n    msg.uiEvent = { tipo: 'error', codigo: 'USUARIO_INACTIVO' };\n    return [msg, null];\n}\n\n// Verificar vigencia\nif (usuario.fecha_vigencia) {\n    const vigencia = new Date(usuario.fecha_vigencia);\n    if (vigencia < new Date()) {\n        msg.payload = {\n            ok: false,\n            error: 'MEMBRESIA_VENCIDA',\n            mensaje: `La membresía de ${usuario.nombre} venció el ${usuario.fecha_vigencia}`,\n            usuario: { id: usuario.id, nombre: `${usuario.nombre} ${usuario.apellido}` }\n        };\n        msg.statusCode = 403;\n        msg.uiEvent = { tipo: 'error', codigo: 'MEMBRESIA_VENCIDA' };\n        return [msg, null];\n    }\n}\n\n// Éxito\nmsg.usuario = usuario;\nmsg.payload = {\n    ok: true,\n    usuario: {\n        id: usuario.id,\n        nombre: `${usuario.nombre} ${usuario.apellido}`,\n        email: usuario.email,\n        tipo: usuario.tipo_usuario,\n        prestamos_actuales: usuario.prestamos_actuales,\n        max_prestamos: usuario.max_prestamos,\n        cupo_disponible: usuario.max_prestamos - usuario.prestamos_actuales\n    }\n};\nmsg.statusCode = 200;\nmsg.uiEvent = { tipo: 'usuario_identificado', usuario: msg.payload.usuario };\nreturn [null, msg];",
        "outputs": 2,
        "x": 1540,
        "y": 60,
        "wires": [
            [
                "http_response_error"
            ],
            [
                "fn_log_auditoria",
                "http_response_ok",
                "mqtt_publish_ui"
            ]
        ]
    },
    {
        "id": "fn_procesar_prestamo",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Validar datos préstamo",
        "func": "// -------------------------------------------------------\n// Validar que lleguen tanto RFID como QR\n// -------------------------------------------------------\nconst { rfid_tag, qr_codigo } = msg;\n\nif (!rfid_tag || !qr_codigo) {\n    msg.payload = {\n        ok: false,\n        error: 'DATOS_INCOMPLETOS',\n        mensaje: 'Se requiere rfid_tag y qr_codigo para realizar un préstamo'\n    };\n    msg.statusCode = 400;\n    return [null, msg];\n}\n\n// Formato RFID\nif (!/^[A-Fa-f0-9]{4,16}$/.test(rfid_tag.trim())) {\n    msg.payload = { ok: false, error: 'RFID_INVALIDO', mensaje: 'Formato de RFID inválido' };\n    msg.statusCode = 422;\n    return [null, msg];\n}\n\n// Formato QR (LIB-XXXXX)\nif (!/^LIB-\\d{5}$/.test(qr_codigo.trim())) {\n    msg.payload = { ok: false, error: 'QR_INVALIDO', mensaje: 'Formato de código QR inválido' };\n    msg.statusCode = 422;\n    return [null, msg];\n}\n\n// Consulta compleja: usuario + ejemplar disponible en una sola query\nmsg.topic = `\nSELECT\n    u.id AS usuario_id,\n    u.nombre || ' ' || u.apellido AS usuario_nombre,\n    u.activo AS usuario_activo,\n    u.fecha_vigencia,\n    u.max_prestamos,\n    (SELECT COUNT(*) FROM prestamos\n     WHERE usuario_id = u.id AND estado = 'activo') AS prestamos_actuales,\n    l.id AS libro_id,\n    l.titulo,\n    l.autor,\n    l.qr_codigo,\n    e.id AS ejemplar_id,\n    e.estado AS ejemplar_estado\nFROM usuarios u, libros l\nLEFT JOIN ejemplares e ON e.libro_id = l.id AND e.estado = 'disponible'\nWHERE u.rfid_tag = ? AND l.qr_codigo = ?\nLIMIT 1`;\nmsg.params = [rfid_tag.trim().toUpperCase(), qr_codigo.trim()];\nmsg.rfid_tag = rfid_tag.trim().toUpperCase();\nmsg.qr_codigo = qr_codigo.trim();\nreturn [msg, null];",
        "outputs": 2,
        "x": 1060,
        "y": 200,
        "wires": [
            [
                "sqlite_query_prestamo"
            ],
            [
                "http_response_error"
            ]
        ]
    },
    {
        "id": "sqlite_query_prestamo",
        "type": "sqlite",
        "z": "tab_biblioteca_iot",
        "mydb": "sqlite_config",
        "sqlquery": "prepared",
        "sql": "",
        "name": "DB: Verificar disponibilidad",
        "x": 1300,
        "y": 200,
        "wires": [
            [
                "fn_ejecutar_prestamo"
            ]
        ]
    },
    {
        "id": "fn_ejecutar_prestamo",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Lógica de préstamo",
        "func": "const rows = msg.payload;\n\n// --- Usuario no encontrado ---\nif (!rows || rows.length === 0) {\n    msg.payload = { ok: false, error: 'TAG_NO_REGISTRADO', mensaje: 'RFID no encontrado' };\n    msg.statusCode = 404;\n    msg.uiEvent = { tipo: 'error', codigo: 'TAG_NO_REGISTRADO' };\n    return [null, msg];\n}\n\nconst data = rows[0];\n\n// --- Libro no encontrado ---\nif (!data.libro_id) {\n    msg.payload = { ok: false, error: 'LIBRO_NO_ENCONTRADO', mensaje: `QR ${msg.qr_codigo} no existe` };\n    msg.statusCode = 404;\n    msg.uiEvent = { tipo: 'error', codigo: 'LIBRO_NO_ENCONTRADO' };\n    return [null, msg];\n}\n\n// --- Usuario inactivo ---\nif (!data.usuario_activo) {\n    msg.payload = { ok: false, error: 'USUARIO_INACTIVO', mensaje: 'Usuario inactivo' };\n    msg.statusCode = 403;\n    msg.uiEvent = { tipo: 'error', codigo: 'USUARIO_INACTIVO' };\n    return [null, msg];\n}\n\n// --- Vigencia vencida ---\nif (data.fecha_vigencia && new Date(data.fecha_vigencia) < new Date()) {\n    msg.payload = { ok: false, error: 'MEMBRESIA_VENCIDA', mensaje: 'Membresía vencida' };\n    msg.statusCode = 403;\n    msg.uiEvent = { tipo: 'error', codigo: 'MEMBRESIA_VENCIDA' };\n    return [null, msg];\n}\n\n// --- Cupo agotado ---\nif (data.prestamos_actuales >= data.max_prestamos) {\n    msg.payload = {\n        ok: false,\n        error: 'CUPO_AGOTADO',\n        mensaje: `${data.usuario_nombre} ya tiene ${data.prestamos_actuales}/${data.max_prestamos} préstamos activos`\n    };\n    msg.statusCode = 409;\n    msg.uiEvent = { tipo: 'error', codigo: 'CUPO_AGOTADO' };\n    return [null, msg];\n}\n\n// --- Ejemplar no disponible ---\nif (data.ejemplar_estado !== 'disponible' || !data.ejemplar_id) {\n    msg.payload = {\n        ok: false,\n        error: 'SIN_EJEMPLARES',\n        mensaje: `\"${data.titulo}\" no tiene ejemplares disponibles en este momento`\n    };\n    msg.statusCode = 409;\n    msg.uiEvent = { tipo: 'error', codigo: 'SIN_EJEMPLARES', libro: data.titulo };\n    return [null, msg];\n}\n\n// --- ✅ Todo válido: preparar transacción ---\nmsg.prestamo_data = data;\n\n// Fecha devolución: 14 días para estudiantes, 30 para docentes\n// (simplificado; se podría parametrizar por tipo_usuario)\nconst diasPrestamo = 14;\nconst devolucion = new Date();\ndevolucion.setDate(devolucion.getDate() + diasPrestamo);\nmsg.fecha_devolucion = devolucion.toISOString().replace('T', ' ').substring(0, 19);\n\n// Transacción SQLite: actualizar ejemplar + insertar préstamo\nmsg.topic = `BEGIN TRANSACTION;\nUPDATE ejemplares SET estado = 'prestado' WHERE id = ${data.ejemplar_id};\nINSERT INTO prestamos\n    (usuario_id, ejemplar_id, fecha_devolucion_esperada, estado, rfid_prestamo, qr_prestamo)\nVALUES\n    (${data.usuario_id}, ${data.ejemplar_id}, '${msg.fecha_devolucion}', 'activo',\n     '${msg.rfid_tag}', '${msg.qr_codigo}');\nINSERT INTO audit_log (tipo, origen, usuario_id, ejemplar_id, mensaje, payload_raw)\nVALUES ('prestamo', 'iot', ${data.usuario_id}, ${data.ejemplar_id},\n    'Préstamo registrado: ${data.titulo}', '${JSON.stringify(msg.scanData || {})}');\nCOMMIT;`;\n\nreturn [msg, null];",
        "outputs": 2,
        "x": 1540,
        "y": 200,
        "wires": [
            [
                "sqlite_exec_prestamo"
            ],
            [
                "http_response_error"
            ]
        ]
    },
    {
        "id": "sqlite_exec_prestamo",
        "type": "sqlite",
        "z": "tab_biblioteca_iot",
        "mydb": "sqlite_config",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "DB: Ejecutar transacción préstamo",
        "x": 1780,
        "y": 200,
        "wires": [
            [
                "fn_respuesta_prestamo"
            ]
        ]
    },
    {
        "id": "fn_respuesta_prestamo",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Confirmar préstamo",
        "func": "const data = msg.prestamo_data;\n\nmsg.payload = {\n    ok: true,\n    accion: 'prestamo',\n    mensaje: `Préstamo registrado exitosamente`,\n    prestamo: {\n        usuario: data.usuario_nombre,\n        libro: data.titulo,\n        autor: data.autor,\n        ejemplar_id: data.ejemplar_id,\n        fecha_devolucion_esperada: msg.fecha_devolucion\n    }\n};\nmsg.statusCode = 201;\nmsg.uiEvent = {\n    tipo: 'prestamo_exitoso',\n    datos: msg.payload.prestamo\n};\nreturn msg;",
        "outputs": 1,
        "x": 2000,
        "y": 200,
        "wires": [
            [
                "http_response_ok",
                "mqtt_publish_ui",
                "fn_log_auditoria"
            ]
        ]
    },
    {
        "id": "fn_procesar_devolucion",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Validar datos devolución",
        "func": "const { rfid_tag, qr_codigo } = msg;\n\nif (!rfid_tag || !qr_codigo) {\n    msg.payload = { ok: false, error: 'DATOS_INCOMPLETOS', mensaje: 'Se requiere rfid_tag y qr_codigo' };\n    msg.statusCode = 400;\n    return [null, msg];\n}\n\n// Buscar préstamo activo que coincida con usuario Y libro\nmsg.topic = `\nSELECT\n    p.id AS prestamo_id,\n    p.ejemplar_id,\n    p.fecha_prestamo,\n    p.fecha_devolucion_esperada,\n    u.nombre || ' ' || u.apellido AS usuario_nombre,\n    l.titulo,\n    l.autor,\n    CASE WHEN p.fecha_devolucion_esperada < datetime('now','localtime') THEN 1 ELSE 0 END AS vencido\nFROM prestamos p\nJOIN usuarios   u ON p.usuario_id  = u.id\nJOIN ejemplares e ON p.ejemplar_id = e.id\nJOIN libros     l ON e.libro_id    = l.id\nWHERE u.rfid_tag  = ?\n  AND l.qr_codigo = ?\n  AND p.estado = 'activo'\nLIMIT 1`;\nmsg.params = [rfid_tag.trim().toUpperCase(), qr_codigo.trim()];\nmsg.rfid_tag  = rfid_tag.trim().toUpperCase();\nmsg.qr_codigo = qr_codigo.trim();\nreturn [msg, null];",
        "outputs": 2,
        "x": 1060,
        "y": 340,
        "wires": [
            [
                "sqlite_query_devolucion"
            ],
            [
                "http_response_error"
            ]
        ]
    },
    {
        "id": "sqlite_query_devolucion",
        "type": "sqlite",
        "z": "tab_biblioteca_iot",
        "mydb": "sqlite_config",
        "sqlquery": "prepared",
        "sql": "",
        "name": "DB: Buscar préstamo activo",
        "x": 1300,
        "y": 340,
        "wires": [
            [
                "fn_ejecutar_devolucion"
            ]
        ]
    },
    {
        "id": "fn_ejecutar_devolucion",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Lógica de devolución",
        "func": "const rows = msg.payload;\n\nif (!rows || rows.length === 0) {\n    msg.payload = {\n        ok: false,\n        error: 'PRESTAMO_NO_ENCONTRADO',\n        mensaje: 'No se encontró un préstamo activo para este usuario y libro'\n    };\n    msg.statusCode = 404;\n    msg.uiEvent = { tipo: 'error', codigo: 'PRESTAMO_NO_ENCONTRADO' };\n    return [null, msg];\n}\n\nconst prestamo = rows[0];\nmsg.prestamo_data = prestamo;\n\nconst ahora = new Date().toISOString().replace('T', ' ').substring(0, 19);\n\n// Transacción: actualizar préstamo + liberar ejemplar\nmsg.topic = `BEGIN TRANSACTION;\nUPDATE prestamos\n    SET estado = 'devuelto',\n        fecha_devolucion_real = '${ahora}',\n        rfid_devolucion = '${msg.rfid_tag}'\n    WHERE id = ${prestamo.prestamo_id};\nUPDATE ejemplares\n    SET estado = 'disponible'\n    WHERE id = ${prestamo.ejemplar_id};\nINSERT INTO audit_log (tipo, origen, mensaje, payload_raw)\n    VALUES ('devolucion', 'iot',\n        'Devolución registrada: ${prestamo.titulo} por ${prestamo.usuario_nombre}',\n        '${JSON.stringify({ prestamo_id: prestamo.prestamo_id })}');\nCOMMIT;`;\n\nreturn [msg, null];",
        "outputs": 2,
        "x": 1540,
        "y": 340,
        "wires": [
            [
                "sqlite_exec_devolucion"
            ],
            [
                "http_response_error"
            ]
        ]
    },
    {
        "id": "sqlite_exec_devolucion",
        "type": "sqlite",
        "z": "tab_biblioteca_iot",
        "mydb": "sqlite_config",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "DB: Ejecutar devolución",
        "x": 1780,
        "y": 340,
        "wires": [
            [
                "fn_respuesta_devolucion"
            ]
        ]
    },
    {
        "id": "fn_respuesta_devolucion",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Confirmar devolución",
        "func": "const prestamo = msg.prestamo_data;\nconst ahora = new Date().toISOString().replace('T', ' ').substring(0, 19);\n\nmsg.payload = {\n    ok: true,\n    accion: 'devolucion',\n    vencido: prestamo.vencido === 1,\n    mensaje: prestamo.vencido\n        ? `Devolución tardía de \"${prestamo.titulo}\" (venció el ${prestamo.fecha_devolucion_esperada})`\n        : `\"${prestamo.titulo}\" devuelto correctamente`,\n    devolucion: {\n        usuario: prestamo.usuario_nombre,\n        libro: prestamo.titulo,\n        autor: prestamo.autor,\n        fecha_devolucion_real: ahora,\n        fecha_devolucion_esperada: prestamo.fecha_devolucion_esperada,\n        dias_retraso: prestamo.vencido\n            ? Math.ceil((new Date() - new Date(prestamo.fecha_devolucion_esperada)) / 86400000)\n            : 0\n    }\n};\nmsg.statusCode = 200;\nmsg.uiEvent = {\n    tipo: prestamo.vencido ? 'devolucion_tardía' : 'devolucion_exitosa',\n    datos: msg.payload.devolucion\n};\nreturn msg;",
        "outputs": 1,
        "x": 2000,
        "y": 340,
        "wires": [
            [
                "http_response_ok",
                "mqtt_publish_ui",
                "fn_log_auditoria"
            ]
        ]
    },
