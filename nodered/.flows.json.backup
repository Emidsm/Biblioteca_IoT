    {
        "id": "3fc4bcf106a5184a",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Insert Libro",
        "func": "\nconst d = msg.payload;\nmsg.topic = `\nBEGIN TRANSACTION;\nINSERT INTO libros (titulo, autor, isbn, editorial, anio_publicacion, qr_codigo)\nVALUES ('${d.titulo}', '${d.autor}', '${d.isbn}', '${d.editorial}', ${d.anio || 'NULL'}, '${d.qr_codigo}');\nINSERT INTO ejemplares (libro_id, estado)\nVALUES (last_insert_rowid(), 'disponible');\nCOMMIT;\n`;\nreturn msg;\n",
