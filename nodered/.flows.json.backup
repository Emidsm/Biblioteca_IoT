        "z": "3b6fce683d31f02e",
        "name": "Query catálogo",
        "func": "\nmsg.topic = `\nSELECT\n    l.id,\n    l.titulo,\n    l.autor,\n    l.isbn,\n    l.editorial,\n    l.anio_publicacion,\n    l.genero,\n    l.qr_codigo,\n    l.ubicacion,\n    COUNT(e.id) FILTER (WHERE e.estado = 'disponible') AS disponibles,\n    COUNT(e.id) AS total_ejemplares\nFROM libros l\nLEFT JOIN ejemplares e ON e.libro_id = l.id\nWHERE l.activo = 1\nGROUP BY l.id\nORDER BY l.titulo ASC`;\nreturn msg;\n",
