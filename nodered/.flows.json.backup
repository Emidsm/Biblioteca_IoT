    {
        "id": "fn_ejecutar_backup",
        "type": "function",
        "z": "tab_backup",
        "name": "Script de respaldo",
        "func": "// -------------------------------------------------------\n// Genera comando shell para copiar el .db de SQLite\n// Utiliza el comando VACUUM INTO de SQLite para un\n// respaldo consistente (no requiere bloquear la BD)\n// -------------------------------------------------------\nconst tipo = msg.payload.tipo || 'manual';\nconst ahora = new Date();\nconst timestamp = ahora.toISOString()\n    .replace(/[:.]/g, '-')\n    .replace('T', '_')\n    .substring(0, 19);\n\nconst DB_PATH     = env.get('SQLITE_DB_PATH') || '/data/biblioteca/biblioteca.db';\nconst BACKUP_DIR  = env.get('BACKUP_DIR')     || '/data/backups';\nconst MAX_BACKUPS = parseInt(env.get('MAX_BACKUPS') || '30');\n\nconst backupFile = `${BACKUP_DIR}/biblioteca_${tipo}_${timestamp}.db`;\n\n// Comando:\n// 1. Crear directorio si no existe\n// 2. Copiar con sqlite3 VACUUM INTO (respaldo limpio y consistente)\n// 3. Comprimir con gzip\n// 4. Limpiar backups antiguos (>MAX_BACKUPS archivos)\nmsg.payload = [\n    `mkdir -p ${BACKUP_DIR}`,\n    `sqlite3 ${DB_PATH} \".timeout 5000\" \".backup ${backupFile}\"`,\n    `gzip -9 ${backupFile}`,\n    `ls -t ${BACKUP_DIR}/biblioteca_*.db.gz | tail -n +${MAX_BACKUPS + 1} | xargs -r rm --`\n].join(' && ');\n\nmsg.backup_meta = { tipo, timestamp, archivo: backupFile + '.gz' };\nnode.log(`Iniciando backup ${tipo}: ${backupFile}.gz`);\nreturn msg;",
        "outputs": 1,
        "x": 440,
        "y": 140,
        "wires": [
            [
                "exec_backup"
            ]
        ]
    },
    {
        "id": "exec_backup",
        "type": "exec",
        "z": "tab_backup",
        "command": "",
        "addpay": true,
        "append": "",
        "useSpawn": false,
        "timer": "60",
        "winHide": false,
        "oldrc": false,
        "name": "Shell: Ejecutar backup",
        "x": 680,
        "y": 140,
        "wires": [
            [
                "fn_backup_resultado"
            ],
            [
                "fn_backup_resultado"
            ],
            [
                "fn_backup_error"
            ]
        ]
    },
    {
        "id": "fn_backup_resultado",
        "type": "function",
        "z": "tab_backup",
        "name": "Registrar resultado backup",
        "func": "const stdout = msg.payload || '';\nconst meta = msg.backup_meta || {};\n\nmsg.topic = `INSERT INTO audit_log (tipo, origen, mensaje)\n    VALUES ('backup', 'sistema', 'Respaldo ${meta.tipo || ''} completado: ${meta.archivo || ''}');`;\n\nnode.status({ fill: 'green', shape: 'dot', text: `OK ${meta.timestamp}` });\nnode.log(`Backup completado: ${meta.archivo}`);\nreturn msg;",
        "outputs": 1,
        "x": 920,
        "y": 120,
        "wires": [
            [
                "sqlite_log_backup"
            ]
        ]
    },
    {
        "id": "fn_backup_error",
        "type": "function",
        "z": "tab_backup",
        "name": "Manejar error backup",
        "func": "const err = msg.payload || 'Error desconocido';\nnode.error(`Error en backup: ${err}`);\nnode.status({ fill: 'red', shape: 'ring', text: 'ERROR backup' });\n\nmsg.topic = `INSERT INTO audit_log (tipo, origen, mensaje)\n    VALUES ('backup', 'sistema', 'ERROR en respaldo: ${String(err).replace(/'/g, \"''\")}');`;\nreturn msg;",
        "outputs": 1,
        "x": 920,
        "y": 180,
        "wires": [
            [
                "sqlite_log_backup"
            ]
        ]
    },
