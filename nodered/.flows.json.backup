        ]
    },
    {
        "id": "ac35d059f06c11e7",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Préstamo web (RFID + libro_id)",
        "func": "\n// Endpoint específico para el dashboard web:\n// Recibe { libro_id } y toma el RFID del flow context\nconst d = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\n\nconst rfid = flow.get('ultimo_rfid');\nconst rfid_ts = flow.get('rfid_ts');\n\nif (!rfid) {\n    msg.payload = { ok: false, error: 'SIN_RFID', mensaje: 'No hay ningún tag RFID activo. Acerca tu tarjeta al lector primero.' };\n    msg.statusCode = 400;\n    return [null, msg];\n}\n\n// Verificar que el RFID no sea demasiado viejo (5 minutos)\nif (rfid_ts) {\n    const segundos = (new Date() - new Date(rfid_ts)) / 1000;\n    if (segundos > 300) {\n        flow.set('ultimo_rfid', null);\n        flow.set('usuario_activo', null);\n        msg.payload = { ok: false, error: 'RFID_EXPIRADO', mensaje: 'La sesión RFID expiró. Vuelve a acercar tu tarjeta al lector.' };\n        msg.statusCode = 400;\n        return [null, msg];\n    }\n}\n\nif (!d || !d.libro_id) {\n    msg.payload = { ok: false, error: 'LIBRO_REQUERIDO', mensaje: 'Selecciona un libro del catálogo' };\n    msg.statusCode = 400;\n    return [null, msg];\n}\n\n// Reutilizar el flujo principal de préstamo\nmsg.scanData = {\n    tipo: 'prestamo',\n    rfid_tag: rfid,\n    libro_id: d.libro_id,\n    origen: 'web_catalog'\n};\nmsg.rfid_tag = rfid;\nmsg.libro_id = d.libro_id;\n\n// Necesitamos un req/res falso para que el flujo funcione sin API key check\n// porque este endpoint es interno del dashboard\nmsg.req = msg.req || { headers: {} };\nmsg.origen = 'web_catalog';\n\nreturn [msg, null];\n",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
