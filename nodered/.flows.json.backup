    {
        "id": "fn_wrap_mqtt_rfid",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Wrap MQTT → formato HTTP",
        "func": "// Normaliza el payload MQTT al mismo formato que HTTP\n// y le inyecta la contraseña \"quemada\" para que pase la seguridad\nmsg.req = { headers: { 'x-api-key': 'secreto123' } };\nmsg.res = null; \nmsg._mqtt = true;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 130,
        "wires": [
            [
                "validate_apikey"
            ]
        ]
    },
    {
        "id": "validate_apikey",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Validar API Key",
        "func": "// -------------------------------------------------------\n// Seguridad: Forzamos la llave 'secreto123' directamente\n// -------------------------------------------------------\nconst expectedKey = 'secreto123';\nconst receivedKey = (msg.req && msg.req.headers)\n    ? msg.req.headers['x-api-key']\n    : null;\n\nif (receivedKey !== expectedKey) {\n    node.warn(`API Key inválida`);\n    msg.payload = { ok: false, error: 'No autorizado' };\n    msg.statusCode = 401;\n    return [null, msg];\n}\n\n// Extraer el payload real\nmsg.scanData = (typeof msg.payload === 'string')\n    ? JSON.parse(msg.payload)\n    : msg.payload;\n\nreturn [msg, null];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 100,
        "wires": [
            [
                "route_scan_type"
            ],
            [
                "http_response_error"
            ]
        ]
    },
    {
        "id": "route_scan_type",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Enrutar por tipo de escaneo",
        "func": "// -------------------------------------------------------\n// Determina si el escaneo es:\n// - rfid: identificación de usuario\n// - qr: identificación de libro\n// - prestamo: acción completa (rfid + qr juntos)\n// - devolucion: devolución de libro\n// -------------------------------------------------------\nconst scan = msg.scanData || {};\n\n// Validación básica de estructura\nif (!scan.tipo) {\n    msg.payload = { ok: false, error: 'Payload inválido: falta campo tipo' };\n    msg.statusCode = 400;\n    return [null, null, null, msg];\n}\n\nmsg.origen = scan.origen || 'desconocido'; // 'rfid', 'qr', 'api'\n\nswitch (scan.tipo) {\n    case 'identificar_usuario':\n        msg.rfid_tag = scan.rfid_tag;\n        return [msg, null, null, null];\n    case 'prestamo':\n        msg.rfid_tag = scan.rfid_tag;\n        msg.qr_codigo = scan.qr_codigo;\n        return [null, msg, null, null];\n    case 'devolucion':\n        msg.rfid_tag = scan.rfid_tag;\n        msg.qr_codigo = scan.qr_codigo;\n        return [null, null, msg, null];\n    default:\n        msg.payload = { ok: false, error: `Tipo desconocido: ${scan.tipo}` };\n        msg.statusCode = 400;\n        return [null, null, null, msg];\n}",
        "outputs": 4,
        "x": 820,
        "y": 100,
        "wires": [
            [
                "fn_identificar_usuario",
                "e4ad02cc690a6600"
            ],
            [
                "fn_procesar_prestamo",
                "e4ad02cc690a6600"
            ],
            [
                "fn_procesar_devolucion",
                "e4ad02cc690a6600"
            ],
            [
                "http_response_error",
                "e4ad02cc690a6600"
            ]
        ]
    },
    {
        "id": "fn_identificar_usuario",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Preparar consulta usuario",
        "func": "const tag = msg.rfid_tag;\n\nif (!tag || typeof tag !== 'string' || tag.trim() === '') {\n    msg.payload = { ok: false, error: 'Tag RFID no válido o vacío' };\n    msg.statusCode = 400;\n    return [null, msg];\n}\n\n// Sanitizar: solo alfanumérico (formato UID RFID)\nif (!/^[A-Fa-f0-9]{4,16}$/.test(tag.trim())) {\n    msg.payload = { ok: false, error: 'Formato de tag RFID inválido' };\n    msg.statusCode = 422;\n    return [null, msg];\n}\n\nconst rfidLimpio = tag.trim().toUpperCase();\n\nmsg.topic = `SELECT id, nombre, apellido, email, tipo_usuario, activo,\n    max_prestamos, fecha_vigencia,\n    (SELECT COUNT(*) FROM prestamos\n     WHERE usuario_id = u.id AND estado = 'activo') AS prestamos_actuales\nFROM usuarios u\nWHERE rfid_tag = '${rfidLimpio}'`;\n\nreturn [msg, null];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1060,
        "y": 60,
        "wires": [
            [
                "sqlite_query_usuario",
                "38eef8ef292bee89"
            ],
            [
                "http_response_error",
                "38eef8ef292bee89"
            ]
        ]
    },
    {
        "id": "sqlite_query_usuario",
        "type": "sqlite",
        "z": "tab_biblioteca_iot",
        "mydb": "sqlite_config",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "DB: Buscar usuario por RFID",
        "x": 1340,
        "y": 40,
        "wires": [
            [
                "fn_respuesta_usuario",
                "f0c9232754148cbf"
            ]
        ]
    },
    {
        "id": "fn_respuesta_usuario",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Procesar respuesta usuario",
        "func": "const rows = msg.payload;\n\nif (!rows || rows.length === 0) {\n    node.warn(`RFID no registrado: ${msg.rfid_tag}`);\n    msg.payload = { ok: false, tipo: 'error', mensaje: 'Tag RFID no encontrado', rfid_tag: msg.rfid_tag };\n    msg.statusCode = 404;\n    return [msg, null];\n}\n\nconst usuario = rows[0];\n\nif (!usuario.activo) {\n    msg.payload = { ok: false, tipo: 'error', mensaje: `El usuario ${usuario.nombre} está inactivo` };\n    msg.statusCode = 403;\n    return [msg, null];\n}\n\nif (usuario.fecha_vigencia && new Date(usuario.fecha_vigencia) < new Date()) {\n    msg.payload = { ok: false, tipo: 'error', mensaje: `Membresía vencida de ${usuario.nombre}` };\n    msg.statusCode = 403;\n    return [msg, null];\n}\n\n// ✅ ÉXITO: Payload formateado para el UI y la API\nmsg.usuario = usuario;\nmsg.payload = {\n    ok: true,\n    tipo: 'usuario_identificado',\n    mensaje: `Lector: ${usuario.nombre} ${usuario.apellido}`,\n    datos: {\n        Perfil: usuario.tipo_usuario,\n        Cupo: `${usuario.prestamos_actuales} de ${usuario.max_prestamos} libros`\n    },\n    usuario: {\n        id: usuario.id,\n        tipo: usuario.tipo_usuario,\n        cupo_disponible: usuario.max_prestamos - usuario.prestamos_actuales\n    }\n};\nmsg.statusCode = 200;\nreturn [null, msg];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1640,
        "y": 40,
        "wires": [
            [
                "http_response_error",
                "2822b5e0bd6b1950"
            ],
            [
                "fn_log_auditoria",
                "http_response_ok",
                "mqtt_publish_ui",
                "2822b5e0bd6b1950"
            ]
        ]
    },
    {
        "id": "fn_procesar_prestamo",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Validar datos préstamo",
        "func": "const { rfid_tag, qr_codigo } = msg;\n\nif (!rfid_tag || !qr_codigo) {\n    msg.payload = { ok: false, error: 'DATOS_INCOMPLETOS', mensaje: 'Se requiere rfid_tag y qr_codigo para realizar un préstamo' };\n    msg.statusCode = 400;\n    return [null, msg];\n}\n\nif (!/^[A-Fa-f0-9]{4,16}$/.test(rfid_tag.trim())) {\n    msg.payload = { ok: false, error: 'RFID_INVALIDO', mensaje: 'Formato de RFID inválido' };\n    msg.statusCode = 422;\n    return [null, msg];\n}\n\nif (!/^LIB-\\d{5}$/.test(qr_codigo.trim())) {\n    msg.payload = { ok: false, error: 'QR_INVALIDO', mensaje: 'Formato de código QR inválido' };\n    msg.statusCode = 422;\n    return [null, msg];\n}\n\nconst rfidLimpio = rfid_tag.trim().toUpperCase();\nconst qrLimpio = qr_codigo.trim();\n\nmsg.rfid_tag = rfidLimpio;\nmsg.qr_codigo = qrLimpio;\n\nmsg.topic = `\nSELECT\n    u.id AS usuario_id,\n    u.nombre || ' ' || u.apellido AS usuario_nombre,\n    u.activo AS usuario_activo,\n    u.fecha_vigencia,\n    u.max_prestamos,\n    (SELECT COUNT(*) FROM prestamos\n     WHERE usuario_id = u.id AND estado = 'activo') AS prestamos_actuales,\n    l.id AS libro_id,\n    l.titulo,\n    l.autor,\n    l.qr_codigo,\n    e.id AS ejemplar_id,\n    e.estado AS ejemplar_estado\nFROM usuarios u, libros l\nLEFT JOIN ejemplares e ON e.libro_id = l.id AND e.estado = 'disponible'\nWHERE u.rfid_tag = '${rfidLimpio}' AND l.qr_codigo = '${qrLimpio}'\nLIMIT 1`;\n\nreturn [msg, null];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1060,
        "y": 200,
        "wires": [
            [
                "sqlite_query_prestamo"
            ],
            [
                "http_response_error"
            ]
        ]
    },
    {
        "id": "sqlite_query_prestamo",
        "type": "sqlite",
        "z": "tab_biblioteca_iot",
        "mydb": "sqlite_config",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "DB: Verificar disponibilidad",
        "x": 1300,
        "y": 200,
        "wires": [
            [
                "fn_ejecutar_prestamo"
            ]
        ]
    },
    {
        "id": "fn_ejecutar_prestamo",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Lógica de préstamo",
        "func": "const rows = msg.payload;\n\n// --- Usuario no encontrado ---\nif (!rows || rows.length === 0) {\n    msg.payload = { ok: false, error: 'TAG_NO_REGISTRADO', mensaje: 'RFID no encontrado' };\n    msg.statusCode = 404;\n    msg.uiEvent = { tipo: 'error', codigo: 'TAG_NO_REGISTRADO' };\n    return [null, msg];\n}\n\nconst data = rows[0];\n\n// --- Libro no encontrado ---\nif (!data.libro_id) {\n    msg.payload = { ok: false, error: 'LIBRO_NO_ENCONTRADO', mensaje: `QR ${msg.qr_codigo} no existe` };\n    msg.statusCode = 404;\n    msg.uiEvent = { tipo: 'error', codigo: 'LIBRO_NO_ENCONTRADO' };\n    return [null, msg];\n}\n\n// --- Usuario inactivo ---\nif (!data.usuario_activo) {\n    msg.payload = { ok: false, error: 'USUARIO_INACTIVO', mensaje: 'Usuario inactivo' };\n    msg.statusCode = 403;\n    msg.uiEvent = { tipo: 'error', codigo: 'USUARIO_INACTIVO' };\n    return [null, msg];\n}\n\n// --- Vigencia vencida ---\nif (data.fecha_vigencia && new Date(data.fecha_vigencia) < new Date()) {\n    msg.payload = { ok: false, error: 'MEMBRESIA_VENCIDA', mensaje: 'Membresía vencida' };\n    msg.statusCode = 403;\n    msg.uiEvent = { tipo: 'error', codigo: 'MEMBRESIA_VENCIDA' };\n    return [null, msg];\n}\n\n// --- Cupo agotado ---\nif (data.prestamos_actuales >= data.max_prestamos) {\n    msg.payload = {\n        ok: false,\n        error: 'CUPO_AGOTADO',\n        mensaje: `${data.usuario_nombre} ya tiene ${data.prestamos_actuales}/${data.max_prestamos} préstamos activos`\n    };\n    msg.statusCode = 409;\n    msg.uiEvent = { tipo: 'error', codigo: 'CUPO_AGOTADO' };\n    return [null, msg];\n}\n\n// --- Ejemplar no disponible ---\nif (data.ejemplar_estado !== 'disponible' || !data.ejemplar_id) {\n    msg.payload = {\n        ok: false,\n        error: 'SIN_EJEMPLARES',\n        mensaje: `\"${data.titulo}\" no tiene ejemplares disponibles en este momento`\n    };\n    msg.statusCode = 409;\n    msg.uiEvent = { tipo: 'error', codigo: 'SIN_EJEMPLARES', libro: data.titulo };\n    return [null, msg];\n}\n\n// --- ✅ Todo válido: preparar transacción ---\nmsg.prestamo_data = data;\n\n// Fecha devolución: 14 días para estudiantes, 30 para docentes\n// (simplificado; se podría parametrizar por tipo_usuario)\nconst diasPrestamo = 14;\nconst devolucion = new Date();\ndevolucion.setDate(devolucion.getDate() + diasPrestamo);\nmsg.fecha_devolucion = devolucion.toISOString().replace('T', ' ').substring(0, 19);\n\n// Transacción SQLite: actualizar ejemplar + insertar préstamo\nmsg.topic = `BEGIN TRANSACTION;\nUPDATE ejemplares SET estado = 'prestado' WHERE id = ${data.ejemplar_id};\nINSERT INTO prestamos\n    (usuario_id, ejemplar_id, fecha_devolucion_esperada, estado, rfid_prestamo, qr_prestamo)\nVALUES\n    (${data.usuario_id}, ${data.ejemplar_id}, '${msg.fecha_devolucion}', 'activo',\n     '${msg.rfid_tag}', '${msg.qr_codigo}');\nINSERT INTO audit_log (tipo, origen, usuario_id, ejemplar_id, mensaje, payload_raw)\nVALUES ('prestamo', 'iot', ${data.usuario_id}, ${data.ejemplar_id},\n    'Préstamo registrado: ${data.titulo}', '${JSON.stringify(msg.scanData || {})}');\nCOMMIT;`;\n\nreturn [msg, null];",
        "outputs": 2,
        "x": 1540,
        "y": 200,
        "wires": [
            [
                "sqlite_exec_prestamo"
            ],
            [
                "http_response_error"
            ]
        ]
    },
    {
        "id": "sqlite_exec_prestamo",
        "type": "sqlite",
        "z": "tab_biblioteca_iot",
        "mydb": "sqlite_config",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "DB: Ejecutar transacción préstamo",
        "x": 1780,
        "y": 200,
        "wires": [
            [
                "fn_respuesta_prestamo"
            ]
        ]
    },
    {
        "id": "fn_respuesta_prestamo",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Confirmar préstamo",
        "func": "const data = msg.prestamo_data;\n\nmsg.payload = {\n    ok: true,\n    tipo: 'prestamo_exitoso',\n    mensaje: `Préstamo: ${data.titulo}`,\n    datos: {\n        Usuario: data.usuario_nombre,\n        Vence: msg.fecha_devolucion.substring(0, 10)\n    },\n    prestamo: {\n        usuario: data.usuario_nombre,\n        libro: data.titulo,\n        autor: data.autor,\n        ejemplar_id: data.ejemplar_id,\n        fecha_devolucion_esperada: msg.fecha_devolucion\n    }\n};\nmsg.statusCode = 201;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 2000,
        "y": 200,
        "wires": [
            [
                "http_response_ok",
                "mqtt_publish_ui",
                "fn_log_auditoria"
            ]
        ]
    },
    {
        "id": "fn_procesar_devolucion",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Validar datos devolución",
        "func": "const { rfid_tag, qr_codigo } = msg;\n\nif (!rfid_tag || !qr_codigo) {\n    msg.payload = { ok: false, error: 'DATOS_INCOMPLETOS', mensaje: 'Se requiere rfid_tag y qr_codigo' };\n    msg.statusCode = 400;\n    return [null, msg];\n}\n\nconst rfidLimpio = rfid_tag.trim().toUpperCase();\nconst qrLimpio = qr_codigo.trim();\n\nmsg.rfid_tag = rfidLimpio;\nmsg.qr_codigo = qrLimpio;\n\nmsg.topic = `\nSELECT\n    p.id AS prestamo_id,\n    p.ejemplar_id,\n    p.fecha_prestamo,\n    p.fecha_devolucion_esperada,\n    u.nombre || ' ' || u.apellido AS usuario_nombre,\n    l.titulo,\n    l.autor,\n    CASE WHEN p.fecha_devolucion_esperada < datetime('now','localtime') THEN 1 ELSE 0 END AS vencido\nFROM prestamos p\nJOIN usuarios   u ON p.usuario_id  = u.id\nJOIN ejemplares e ON p.ejemplar_id = e.id\nJOIN libros     l ON e.libro_id    = l.id\nWHERE u.rfid_tag  = '${rfidLimpio}'\n  AND l.qr_codigo = '${qrLimpio}'\n  AND p.estado = 'activo'\nLIMIT 1`;\n\nreturn [msg, null];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1060,
        "y": 340,
        "wires": [
            [
                "sqlite_query_devolucion"
            ],
            [
                "http_response_error"
            ]
        ]
    },
    {
        "id": "sqlite_query_devolucion",
        "type": "sqlite",
        "z": "tab_biblioteca_iot",
        "mydb": "sqlite_config",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "DB: Buscar préstamo activo",
        "x": 1300,
        "y": 340,
        "wires": [
            [
                "fn_ejecutar_devolucion"
            ]
        ]
    },
    {
        "id": "fn_ejecutar_devolucion",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Lógica de devolución",
        "func": "const rows = msg.payload;\n\nif (!rows || rows.length === 0) {\n    msg.payload = {\n        ok: false,\n        error: 'PRESTAMO_NO_ENCONTRADO',\n        mensaje: 'No se encontró un préstamo activo para este usuario y libro'\n    };\n    msg.statusCode = 404;\n    msg.uiEvent = { tipo: 'error', codigo: 'PRESTAMO_NO_ENCONTRADO' };\n    return [null, msg];\n}\n\nconst prestamo = rows[0];\nmsg.prestamo_data = prestamo;\n\nconst ahora = new Date().toISOString().replace('T', ' ').substring(0, 19);\n\n// Transacción: actualizar préstamo + liberar ejemplar\nmsg.topic = `BEGIN TRANSACTION;\nUPDATE prestamos\n    SET estado = 'devuelto',\n        fecha_devolucion_real = '${ahora}',\n        rfid_devolucion = '${msg.rfid_tag}'\n    WHERE id = ${prestamo.prestamo_id};\nUPDATE ejemplares\n    SET estado = 'disponible'\n    WHERE id = ${prestamo.ejemplar_id};\nINSERT INTO audit_log (tipo, origen, mensaje, payload_raw)\n    VALUES ('devolucion', 'iot',\n        'Devolución registrada: ${prestamo.titulo} por ${prestamo.usuario_nombre}',\n        '${JSON.stringify({ prestamo_id: prestamo.prestamo_id })}');\nCOMMIT;`;\n\nreturn [msg, null];",
        "outputs": 2,
        "x": 1540,
        "y": 340,
        "wires": [
            [
                "sqlite_exec_devolucion"
            ],
            [
                "http_response_error"
            ]
        ]
    },
    {
        "id": "sqlite_exec_devolucion",
        "type": "sqlite",
        "z": "tab_biblioteca_iot",
        "mydb": "sqlite_config",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "DB: Ejecutar devolución",
        "x": 1780,
        "y": 340,
        "wires": [
            [
                "fn_respuesta_devolucion"
            ]
        ]
    },
    {
        "id": "fn_respuesta_devolucion",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Confirmar devolución",
        "func": "const prestamo = msg.prestamo_data;\nconst ahora = new Date().toISOString().replace('T', ' ').substring(0, 19);\nconst vencido = prestamo.vencido === 1;\n\nmsg.payload = {\n    ok: true,\n    tipo: vencido ? 'devolucion_tardía' : 'devolucion_exitosa',\n    mensaje: vencido \n        ? `Devolución TARDÍA: ${prestamo.titulo}` \n        : `Devolución OK: ${prestamo.titulo}`,\n    datos: {\n        Usuario: prestamo.usuario_nombre,\n        // Agregamos .getTime() para que la resta sea entre números y no tire error\n        Retraso: vencido ? `${Math.ceil((new Date().getTime() - new Date(prestamo.fecha_devolucion_esperada).getTime()) / 86400000)} días` : 'Ninguno'\n    },\n    devolucion: {\n        usuario: prestamo.usuario_nombre,\n        libro: prestamo.titulo,\n        autor: prestamo.autor,\n        fecha_devolucion_real: ahora,\n        fecha_devolucion_esperada: prestamo.fecha_devolucion_esperada\n    }\n};\nmsg.statusCode = 200;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 2000,
        "y": 340,
        "wires": [
            [
                "http_response_ok",
                "mqtt_publish_ui",
                "fn_log_auditoria"
            ]
        ]
    },
    {
        "id": "http_get_stats",
        "type": "http in",
        "z": "tab_biblioteca_iot",
        "name": "GET /api/stats",
        "url": "/api/stats",
        "method": "get",
        "x": 140,
        "y": 480,
        "wires": [
            [
                "fn_query_stats"
            ]
        ]
    },
    {
        "id": "fn_query_stats",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Query estadísticas",
        "func": "msg.topic = `SELECT * FROM estadisticas_dashboard;\nSELECT * FROM prestamos_activos ORDER BY vencido DESC, fecha_devolucion_esperada ASC LIMIT 20;`;\nreturn msg;",
        "outputs": 1,
        "x": 340,
        "y": 480,
        "wires": [
            [
                "sqlite_query_stats"
            ]
        ]
    },
    {
        "id": "sqlite_query_stats",
        "type": "sqlite",
        "z": "tab_biblioteca_iot",
        "mydb": "sqlite_config",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "DB: Estadísticas",
        "x": 560,
        "y": 480,
        "wires": [
            [
                "fn_format_stats"
            ]
        ]
    },
    {
        "id": "fn_format_stats",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Formatear stats",
        "func": "// La consulta múltiple devuelve array de resultados\nconst results = Array.isArray(msg.payload) ? msg.payload : [msg.payload];\nmsg.payload = {\n    ok: true,\n    timestamp: new Date().toISOString(),\n    estadisticas: results[0] && results[0][0] ? results[0][0] : {},\n    prestamos_activos: results[1] || []\n};\nmsg.statusCode = 200;\nreturn msg;",
        "outputs": 1,
        "x": 780,
        "y": 480,
        "wires": [
            [
                "http_response_ok"
            ]
        ]
    },
    {
        "id": "http_response_ok",
        "type": "http response",
        "z": "tab_biblioteca_iot",
        "name": "HTTP 200/201",
        "statusCode": "",
        "headers": {
            "Content-Type": "application/json"
        },
        "x": 2240,
        "y": 100,
        "wires": []
    },
    {
        "id": "http_response_error",
        "type": "http response",
        "z": "tab_biblioteca_iot",
        "name": "HTTP Error",
        "statusCode": "",
        "headers": {
            "Content-Type": "application/json"
        },
        "x": 2240,
        "y": 160,
        "wires": []
    },
    {
        "id": "mqtt_publish_ui",
        "type": "mqtt out",
        "z": "tab_biblioteca_iot",
        "name": "MQTT → UI Dashboard",
        "topic": "biblioteca/ui/eventos",
        "qos": "1",
        "retain": false,
        "broker": "mqtt_broker_config",
        "x": 2260,
        "y": 220,
        "wires": []
    },
    {
        "id": "fn_log_auditoria",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Log a consola",
        "func": "// Solo log en desarrollo; en producción usar nodo debug con nivel 'warning'\nif (env.get('NODE_ENV') !== 'production') {\n    node.log(`[AUDIT] ${msg.payload && msg.payload.accion || 'evento'}: ${JSON.stringify(msg.payload)}`);\n}\nreturn null; // No propagar",
        "outputs": 0,
        "x": 2260,
        "y": 280,
        "wires": []
    },
    {
        "id": "http_get_dashboard",
        "type": "http in",
        "z": "tab_biblioteca_iot",
        "name": "GET /dashboard",
        "url": "/dashboard",
        "method": "get",
        "upload": false,
        "swaggerDoc": "",
        "x": 260,
        "y": 680,
        "wires": [
            [
                "template_dashboard"
            ]
        ]
    },
    {
        "id": "template_dashboard",
        "type": "template",
        "z": "tab_biblioteca_iot",
        "name": "HTML Dashboard",
        "field": "payload",
        "fieldType": "msg",
        "format": "html",
        "syntax": "html",
        "template": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>BiblioSys — Panel de Control</title>\n\n<!-- Paho MQTT (WebSocket) -->\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/paho-mqtt/1.1.0/paho-mqtt.min.js\"></script>\n<!-- QRCode.js para generar QR de libros -->\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js\"></script>\n<!-- Google Fonts -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,700;1,9..144,400&display=swap\" rel=\"stylesheet\">\n\n<style>\n/* ════════════════════════════════════════════\n   VARIABLES & RESET\n════════════════════════════════════════════ */\n:root {\n  --bg:        #0f0e0b;\n  --bg2:       #181712;\n  --bg3:       #211f18;\n  --border:    #2e2b22;\n  --ink:       #e8e2d4;\n  --ink2:      #9a9080;\n  --ink3:      #5a5448;\n  --gold:      #c8a84b;\n  --gold2:     #8c6e28;\n  --green:     #4caf7d;\n  --red:       #d64f3c;\n  --amber:     #e09b3a;\n  --blue:      #4a8fc4;\n\n  --font-serif: 'Fraunces', Georgia, serif;\n  --font-mono:  'DM Mono', monospace;\n\n  --radius:    6px;\n  --shadow:    0 2px 16px rgba(0,0,0,.5);\n}\n\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\nhtml { font-size: 15px; }\n\nbody {\n  background: var(--bg);\n  color: var(--ink);\n  font-family: var(--font-mono);\n  min-height: 100vh;\n  line-height: 1.6;\n}\n\n/* ════════════════════════════════════════════\n   LAYOUT PRINCIPAL\n════════════════════════════════════════════ */\n.shell {\n  display: grid;\n  grid-template-rows: auto 1fr;\n  min-height: 100vh;\n}\n\n/* HEADER */\nheader {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 2rem;\n  height: 56px;\n  border-bottom: 1px solid var(--border);\n  background: var(--bg2);\n  position: sticky; top: 0; z-index: 100;\n}\n\n.header-brand {\n  display: flex; align-items: center; gap: .75rem;\n}\n.header-brand .logo {\n  width: 32px; height: 32px;\n  background: var(--gold);\n  clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);\n  display: grid; place-items: center;\n  font-size: .7rem; font-weight: 500; color: var(--bg);\n}\n.header-brand h1 {\n  font-family: var(--font-serif);\n  font-size: 1.15rem;\n  font-weight: 700;\n  color: var(--ink);\n  letter-spacing: -.02em;\n}\n.header-brand span {\n  color: var(--gold);\n}\n\n.header-right {\n  display: flex; align-items: center; gap: 1.5rem;\n}\n\n.status-pill {\n  display: flex; align-items: center; gap: .4rem;\n  font-size: .75rem; color: var(--ink2);\n}\n.status-dot {\n  width: 7px; height: 7px; border-radius: 50%;\n  background: var(--ink3);\n  transition: background .3s;\n}\n.status-dot.online  { background: var(--green); box-shadow: 0 0 6px var(--green); }\n.status-dot.offline { background: var(--red); }\n\n#clock {\n  font-size: .78rem; color: var(--ink3);\n}\n\n/* NAV TABS */\nnav {\n  display: flex; gap: 0;\n  padding: 0 2rem;\n  background: var(--bg2);\n  border-bottom: 1px solid var(--border);\n  overflow-x: auto;\n}\nnav button {\n  background: none; border: none; cursor: pointer;\n  font-family: var(--font-mono);\n  font-size: .78rem;\n  color: var(--ink3);\n  padding: .65rem 1.2rem;\n  border-bottom: 2px solid transparent;\n  transition: color .2s, border-color .2s;\n  white-space: nowrap;\n}\nnav button:hover { color: var(--ink2); }\nnav button.active {\n  color: var(--gold);\n  border-bottom-color: var(--gold);\n}\n\n/* MAIN CONTENT */\nmain {\n  padding: 2rem;\n  max-width: 1400px;\n  margin: 0 auto;\n  width: 100%;\n}\n\n.tab-panel { display: none; }\n.tab-panel.active { display: block; }\n\n/* ════════════════════════════════════════════\n   COMPONENTES REUTILIZABLES\n════════════════════════════════════════════ */\n\n/* Tarjeta base */\n.card {\n  background: var(--bg2);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: 1.25rem 1.5rem;\n}\n\n.card-title {\n  font-size: .7rem;\n  letter-spacing: .1em;\n  text-transform: uppercase;\n  color: var(--ink3);\n  margin-bottom: 1rem;\n}\n\n/* KPI Cards */\n.kpi-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));\n  gap: 1rem;\n  margin-bottom: 2rem;\n}\n.kpi {\n  background: var(--bg2);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: 1.25rem;\n  position: relative;\n  overflow: hidden;\n  transition: border-color .2s;\n}\n.kpi::before {\n  content: '';\n  position: absolute; top: 0; left: 0; right: 0; height: 2px;\n  background: var(--accent, var(--gold));\n}\n.kpi:hover { border-color: var(--accent, var(--gold)); }\n.kpi-label {\n  font-size: .68rem; letter-spacing: .09em; text-transform: uppercase;\n  color: var(--ink3); margin-bottom: .5rem;\n}\n.kpi-value {\n  font-family: var(--font-serif);\n  font-size: 2.2rem;\n  font-weight: 700;\n  line-height: 1;\n  color: var(--accent, var(--gold));\n}\n.kpi-sub { font-size: .7rem; color: var(--ink3); margin-top: .35rem; }\n\n/* Tabla */\n.table-wrap { overflow-x: auto; }\ntable {\n  width: 100%; border-collapse: collapse;\n  font-size: .8rem;\n}\nthead th {\n  text-align: left;\n  font-size: .65rem; letter-spacing: .08em; text-transform: uppercase;\n  color: var(--ink3);\n  padding: .6rem .8rem;\n  border-bottom: 1px solid var(--border);\n}\ntbody tr {\n  border-bottom: 1px solid var(--border);\n  transition: background .15s;\n}\ntbody tr:hover { background: var(--bg3); }\ntbody td { padding: .6rem .8rem; color: var(--ink2); }\ntbody td:first-child { color: var(--ink); }\n.badge {\n  display: inline-block;\n  padding: .15rem .5rem;\n  border-radius: 3px;\n  font-size: .65rem;\n  letter-spacing: .05em;\n  text-transform: uppercase;\n}\n.badge-green  { background: rgba(76,175,125,.15); color: var(--green); }\n.badge-red    { background: rgba(214,79,60,.15);  color: var(--red); }\n.badge-amber  { background: rgba(224,155,58,.15); color: var(--amber); }\n.badge-blue   { background: rgba(74,143,196,.15); color: var(--blue); }\n.badge-gold   { background: rgba(200,168,75,.15); color: var(--gold); }\n\n/* Inputs & Formularios */\n.form-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));\n  gap: 1rem;\n  margin-bottom: 1.25rem;\n}\n.field { display: flex; flex-direction: column; gap: .35rem; }\n.field label { font-size: .7rem; letter-spacing: .07em; text-transform: uppercase; color: var(--ink3); }\n.field input, .field select, .field textarea {\n  background: var(--bg3);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: .55rem .75rem;\n  color: var(--ink);\n  font-family: var(--font-mono);\n  font-size: .82rem;\n  outline: none;\n  transition: border-color .2s;\n}\n.field input:focus, .field select:focus, .field textarea:focus {\n  border-color: var(--gold);\n}\n.field input::placeholder { color: var(--ink3); }\n\n/* Botones */\n.btn {\n  display: inline-flex; align-items: center; gap: .4rem;\n  padding: .55rem 1.25rem;\n  border-radius: var(--radius);\n  font-family: var(--font-mono);\n  font-size: .8rem;\n  font-weight: 500;\n  cursor: pointer;\n  border: none;\n  transition: opacity .2s, transform .1s;\n}\n.btn:active { transform: scale(.97); }\n.btn:disabled { opacity: .4; cursor: not-allowed; }\n.btn-gold   { background: var(--gold); color: var(--bg); }\n.btn-ghost  { background: transparent; border: 1px solid var(--border); color: var(--ink2); }\n.btn-ghost:hover { border-color: var(--ink2); }\n.btn-red    { background: rgba(214,79,60,.2); color: var(--red); border: 1px solid rgba(214,79,60,.3); }\n\n/* Feed de eventos */\n.event-feed {\n  display: flex; flex-direction: column; gap: .5rem;\n  max-height: 420px; overflow-y: auto;\n  padding-right: .25rem;\n}\n.event-feed::-webkit-scrollbar { width: 4px; }\n.event-feed::-webkit-scrollbar-track { background: var(--bg3); }\n.event-feed::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }\n\n.event-item {\n  display: grid;\n  grid-template-columns: 2.5rem 1fr auto;\n  gap: .75rem;\n  align-items: start;\n  padding: .75rem .9rem;\n  background: var(--bg3);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  animation: slideIn .25s ease;\n}\n@keyframes slideIn {\n  from { opacity: 0; transform: translateY(-6px); }\n  to   { opacity: 1; transform: translateY(0); }\n}\n.event-icon {\n  width: 2.5rem; height: 2.5rem;\n  border-radius: 50%;\n  display: grid; place-items: center;\n  font-size: 1rem;\n  flex-shrink: 0;\n}\n.event-icon.prestamo   { background: rgba(76,175,125,.2);  color: var(--green); }\n.event-icon.devolucion { background: rgba(74,143,196,.2);  color: var(--blue); }\n.event-icon.error      { background: rgba(214,79,60,.2);   color: var(--red); }\n.event-icon.usuario    { background: rgba(200,168,75,.2);  color: var(--gold); }\n.event-icon.sistema    { background: rgba(90,84,72,.2);    color: var(--ink2); }\n\n.event-body {}\n.event-title { font-size: .82rem; color: var(--ink); margin-bottom: .15rem; }\n.event-meta  { font-size: .72rem; color: var(--ink3); }\n.event-time  { font-size: .7rem; color: var(--ink3); white-space: nowrap; }\n\n/* Sección con título */\n.section-header {\n  display: flex; align-items: center; justify-content: space-between;\n  margin-bottom: 1rem;\n}\n.section-title {\n  font-family: var(--font-serif);\n  font-size: 1.1rem;\n  font-weight: 300;\n  font-style: italic;\n  color: var(--ink);\n}\n\n/* QR Preview */\n#qr-preview-box {\n  background: white;\n  padding: 1rem;\n  border-radius: var(--radius);\n  display: inline-block;\n  margin-top: 1rem;\n}\n#qr-preview-box canvas,\n#qr-preview-box img { display: block; }\n\n/* Grid 2 col */\n.grid-2 {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 1.5rem;\n}\n@media (max-width: 900px) { .grid-2 { grid-template-columns: 1fr; } }\n\n/* Toast notifications */\n#toast-container {\n  position: fixed; bottom: 1.5rem; right: 1.5rem;\n  display: flex; flex-direction: column-reverse; gap: .5rem;\n  z-index: 9999;\n}\n.toast {\n  padding: .75rem 1.1rem;\n  border-radius: var(--radius);\n  font-size: .8rem;\n  max-width: 320px;\n  animation: toastIn .25s ease;\n  border-left: 3px solid;\n}\n@keyframes toastIn {\n  from { opacity: 0; transform: translateX(12px); }\n  to   { opacity: 1; transform: translateX(0); }\n}\n.toast-ok    { background: var(--bg3); border-color: var(--green); color: var(--ink); }\n.toast-err   { background: var(--bg3); border-color: var(--red);   color: var(--ink); }\n.toast-warn  { background: var(--bg3); border-color: var(--amber); color: var(--ink); }\n\n/* Empty state */\n.empty { text-align: center; padding: 3rem 1rem; color: var(--ink3); font-size: .8rem; }\n.empty big { display: block; font-size: 2rem; margin-bottom: .5rem; }\n\n/* Config pills */\n.cfg-row {\n  display: flex; flex-wrap: wrap; gap: .75rem;\n  padding: 1rem 1.5rem;\n  background: var(--bg3);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  font-size: .75rem;\n  color: var(--ink2);\n  margin-bottom: 2rem;\n}\n.cfg-row strong { color: var(--gold); }\n</style>\n</head>\n<body>\n\n<div id=\"toast-container\"></div>\n\n<div class=\"shell\">\n  <!-- HEADER -->\n  <header>\n    <div class=\"header-brand\">\n      <div class=\"logo\">📚</div>\n      <h1>Biblio<span>Sys</span></h1>\n    </div>\n    <div class=\"header-right\">\n      <div class=\"status-pill\">\n        <div class=\"status-dot\" id=\"mqtt-dot\"></div>\n        <span id=\"mqtt-label\">MQTT desconectado</span>\n      </div>\n      <div class=\"status-pill\">\n        <div class=\"status-dot\" id=\"api-dot\"></div>\n        <span id=\"api-label\">API —</span>\n      </div>\n      <span id=\"clock\">—</span>\n    </div>\n  </header>\n\n  <!-- NAV -->\n  <nav id=\"main-nav\">\n    <button class=\"active\" data-tab=\"tab-dashboard\">📊 Dashboard</button>\n    <button data-tab=\"tab-prestamos\">📖 Préstamos</button>\n    <button data-tab=\"tab-eventos\">⚡ Eventos en vivo</button>\n    <button data-tab=\"tab-registrar-usuario\">👤 Registrar usuario</button>\n    <button data-tab=\"tab-registrar-libro\">📗 Registrar libro</button>\n    <button data-tab=\"tab-auditoria\">🗂 Auditoría</button>\n    <button data-tab=\"tab-config\">⚙️ Configuración</button>\n  </nav>\n\n  <!-- MAIN -->\n  <main>\n\n    <!-- ══════════ TAB: DASHBOARD ══════════ -->\n    <div class=\"tab-panel active\" id=\"tab-dashboard\">\n\n      <div class=\"section-header\" style=\"margin-bottom:1.5rem\">\n        <h2 class=\"section-title\">Resumen del sistema</h2>\n        <button class=\"btn btn-ghost\" onclick=\"loadStats()\">↻ Actualizar</button>\n      </div>\n\n      <!-- KPIs -->\n      <div class=\"kpi-grid\" id=\"kpi-grid\">\n        <div class=\"kpi\" style=\"--accent:var(--gold)\">\n          <div class=\"kpi-label\">Libros totales</div>\n          <div class=\"kpi-value\" id=\"kpi-libros\">—</div>\n          <div class=\"kpi-sub\">en catálogo</div>\n        </div>\n        <div class=\"kpi\" style=\"--accent:var(--blue)\">\n          <div class=\"kpi-label\">Préstamos activos</div>\n          <div class=\"kpi-value\" id=\"kpi-prestamos\">—</div>\n          <div class=\"kpi-sub\">en circulación</div>\n        </div>\n        <div class=\"kpi\" style=\"--accent:var(--red)\">\n          <div class=\"kpi-label\">Vencidos</div>\n          <div class=\"kpi-value\" id=\"kpi-vencidos\">—</div>\n          <div class=\"kpi-sub\">fuera de fecha</div>\n        </div>\n        <div class=\"kpi\" style=\"--accent:var(--green)\">\n          <div class=\"kpi-label\">Usuarios activos</div>\n          <div class=\"kpi-value\" id=\"kpi-usuarios\">—</div>\n          <div class=\"kpi-sub\">registrados</div>\n        </div>\n        <div class=\"kpi\" style=\"--accent:var(--amber)\">\n          <div class=\"kpi-label\">Ejemplares disp.</div>\n          <div class=\"kpi-value\" id=\"kpi-disponibles\">—</div>\n          <div class=\"kpi-sub\">listos para prestar</div>\n        </div>\n        <div class=\"kpi\" style=\"--accent:var(--ink2)\">\n          <div class=\"kpi-label\">Última actualiz.</div>\n          <div class=\"kpi-value\" id=\"kpi-ts\" style=\"font-size:1rem; padding-top:.5rem\">—</div>\n          <div class=\"kpi-sub\">&nbsp;</div>\n        </div>\n      </div>\n\n      <!-- Préstamos activos (mini tabla) -->\n      <div class=\"card\">\n        <div class=\"card-title\">Préstamos activos — próximos a vencer primero</div>\n        <div class=\"table-wrap\">\n          <table>\n            <thead>\n              <tr>\n                <th>Usuario</th><th>Libro</th><th>Desde</th>\n                <th>Vence</th><th>Estado</th>\n              </tr>\n            </thead>\n            <tbody id=\"dash-prestamos-tbody\">\n              <tr><td colspan=\"5\" class=\"empty\"><big>📂</big>Cargando…</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n\n    <!-- ══════════ TAB: PRÉSTAMOS ══════════ -->\n    <div class=\"tab-panel\" id=\"tab-prestamos\">\n      <div class=\"section-header\">\n        <h2 class=\"section-title\">Préstamos activos</h2>\n        <button class=\"btn btn-ghost\" onclick=\"loadStats()\">↻ Actualizar</button>\n      </div>\n      <div class=\"card\">\n        <div class=\"table-wrap\">\n          <table>\n            <thead>\n              <tr>\n                <th>#</th><th>Usuario</th><th>Libro</th><th>Autor</th>\n                <th>F. Préstamo</th><th>F. Devolución</th><th>Estado</th>\n              </tr>\n            </thead>\n            <tbody id=\"prestamos-tbody\">\n              <tr><td colspan=\"7\" class=\"empty\"><big>📂</big>Sin datos</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n\n    <!-- ══════════ TAB: EVENTOS EN VIVO ══════════ -->\n    <div class=\"tab-panel\" id=\"tab-eventos\">\n      <div class=\"section-header\">\n        <h2 class=\"section-title\">Feed de eventos MQTT</h2>\n        <button class=\"btn btn-ghost btn-red\" onclick=\"clearFeed()\">🗑 Limpiar</button>\n      </div>\n      <p style=\"font-size:.75rem; color:var(--ink3); margin-bottom:1rem;\">\n        Suscrito a <code style=\"color:var(--gold)\">biblioteca/ui/eventos</code> — los eventos aparecen aquí en tiempo real cuando la bibliotecaria o los lectores IoT realizan operaciones.\n      </p>\n      <div class=\"event-feed\" id=\"event-feed\">\n        <div class=\"empty\"><big>📡</big>Esperando eventos MQTT…</div>\n      </div>\n    </div>\n\n    <!-- ══════════ TAB: REGISTRAR USUARIO ══════════ -->\n    <div class=\"tab-panel\" id=\"tab-registrar-usuario\">\n      <div class=\"section-header\">\n        <h2 class=\"section-title\">Registrar nuevo usuario</h2>\n      </div>\n\n      <!-- TODO BACKEND: necesitas agregar a Node-RED:\n           POST /api/usuarios  con campos: nombre, apellido, email, rfid_tag, tipo_usuario, max_prestamos\n           INSERT INTO usuarios (...) VALUES (...)\n      -->\n      <div style=\"background:rgba(224,155,58,.08); border:1px solid rgba(224,155,58,.2); border-radius:var(--radius); padding:.75rem 1rem; margin-bottom:1.5rem; font-size:.75rem; color:var(--amber);\">\n        ⚠️ <strong>TODO Node-RED:</strong> Agrega un nodo <code>http in POST /api/usuarios</code> que haga INSERT en la tabla <code>usuarios</code>. El botón de abajo ya envía el JSON correcto.\n      </div>\n\n      <div class=\"grid-2\">\n        <div class=\"card\">\n          <div class=\"card-title\">Datos personales</div>\n          <div class=\"form-grid\">\n            <div class=\"field\">\n              <label>Nombre</label>\n              <input type=\"text\" id=\"u-nombre\" placeholder=\"María\">\n            </div>\n            <div class=\"field\">\n              <label>Apellido</label>\n              <input type=\"text\" id=\"u-apellido\" placeholder=\"García López\">\n            </div>\n            <div class=\"field\">\n              <label>Email</label>\n              <input type=\"email\" id=\"u-email\" placeholder=\"maria@escuela.edu\">\n            </div>\n            <div class=\"field\">\n              <label>Tipo de usuario</label>\n              <select id=\"u-tipo\">\n                <option value=\"estudiante\">Estudiante</option>\n                <option value=\"docente\">Docente</option>\n                <option value=\"personal\">Personal administrativo</option>\n              </select>\n            </div>\n            <div class=\"field\">\n              <label>Máx. préstamos</label>\n              <input type=\"number\" id=\"u-maxprestamos\" value=\"3\" min=\"1\" max=\"10\">\n            </div>\n            <div class=\"field\">\n              <label>Vigencia (fecha)</label>\n              <input type=\"date\" id=\"u-vigencia\">\n            </div>\n          </div>\n\n          <div class=\"card-title\" style=\"margin-top:.5rem\">Tag RFID</div>\n          <div class=\"form-grid\">\n            <div class=\"field\">\n              <label>UID del tag (hex)</label>\n              <input type=\"text\" id=\"u-rfid\" placeholder=\"A1B2C3D4\" maxlength=\"16\"\n                     oninput=\"this.value=this.value.toUpperCase().replace(/[^A-F0-9]/g,'')\">\n            </div>\n          </div>\n          <div style=\"display:flex; gap:.75rem; flex-wrap:wrap;\">\n            <button class=\"btn btn-gold\" onclick=\"registrarUsuario()\">✚ Registrar usuario</button>\n            <button class=\"btn btn-ghost\" onclick=\"limpiarFormUsuario()\">Limpiar</button>\n          </div>\n        </div>\n\n        <!-- Vista previa / instrucciones -->\n        <div class=\"card\">\n          <div class=\"card-title\">Cómo asignar el tag RFID</div>\n          <div style=\"font-size:.8rem; color:var(--ink2); line-height:1.9;\">\n            <p>1. Acerca el lector RFID al tag del usuario.</p>\n            <p>2. El UID aparece en el monitor serial o en el feed de eventos MQTT.</p>\n            <p>3. Cópialo en el campo <em>UID del tag</em> (solo caracteres hexadecimales, 4–16 dígitos).</p>\n            <p>4. Haz clic en <strong style=\"color:var(--gold)\">Registrar usuario</strong>.</p>\n          </div>\n          <hr style=\"border-color:var(--border); margin:1rem 0;\">\n          <div class=\"card-title\">Vista previa del payload</div>\n          <pre id=\"u-payload-preview\" style=\"font-size:.72rem; color:var(--ink3); white-space:pre-wrap; word-break:break-all;\">—</pre>\n        </div>\n      </div>\n    </div>\n\n    <!-- ══════════ TAB: REGISTRAR LIBRO ══════════ -->\n    <div class=\"tab-panel\" id=\"tab-registrar-libro\">\n      <div class=\"section-header\">\n        <h2 class=\"section-title\">Registrar libro y generar QR</h2>\n      </div>\n\n      <!-- TODO BACKEND:\n           POST /api/libros  con campos: titulo, autor, isbn, editorial, anio, ejemplares (int)\n           INSERT INTO libros (...) + N INSERT INTO ejemplares (...)\n      -->\n      <div style=\"background:rgba(224,155,58,.08); border:1px solid rgba(224,155,58,.2); border-radius:var(--radius); padding:.75rem 1rem; margin-bottom:1.5rem; font-size:.75rem; color:var(--amber);\">\n        ⚠️ <strong>TODO Node-RED:</strong> Agrega <code>http in POST /api/libros</code>. El código QR se genera <em>aquí en el navegador</em> inmediatamente con el ID/ISBN — puedes imprimirlo antes de que llegue la confirmación del servidor.\n      </div>\n\n      <div class=\"grid-2\">\n        <div class=\"card\">\n          <div class=\"card-title\">Datos del libro</div>\n          <div class=\"form-grid\">\n            <div class=\"field\" style=\"grid-column:1/-1\">\n              <label>Título</label>\n              <input type=\"text\" id=\"l-titulo\" placeholder=\"Cien Años de Soledad\"\n                     oninput=\"previewQR()\">\n            </div>\n            <div class=\"field\">\n              <label>Autor</label>\n              <input type=\"text\" id=\"l-autor\" placeholder=\"Gabriel García Márquez\">\n            </div>\n            <div class=\"field\">\n              <label>ISBN</label>\n              <input type=\"text\" id=\"l-isbn\" placeholder=\"978-0-06-088328-7\"\n                     oninput=\"previewQR()\">\n            </div>\n            <div class=\"field\">\n              <label>Editorial</label>\n              <input type=\"text\" id=\"l-editorial\" placeholder=\"Harper Collins\">\n            </div>\n            <div class=\"field\">\n              <label>Año</label>\n              <input type=\"number\" id=\"l-anio\" placeholder=\"2004\">\n            </div>\n            <div class=\"field\">\n              <label>Número de ejemplares</label>\n              <input type=\"number\" id=\"l-ejemplares\" value=\"1\" min=\"1\" max=\"50\">\n            </div>\n            <div class=\"field\">\n              <label>Código QR personalizado (dejar vacío = auto)</label>\n              <input type=\"text\" id=\"l-qr\" placeholder=\"LIB-00042\" maxlength=\"12\"\n                     oninput=\"previewQR()\">\n            </div>\n          </div>\n          <div style=\"display:flex; gap:.75rem; flex-wrap:wrap;\">\n            <button class=\"btn btn-gold\" onclick=\"registrarLibro()\">✚ Registrar libro</button>\n            <button class=\"btn btn-ghost\" onclick=\"imprimirQR()\">🖨 Imprimir QR</button>\n            <button class=\"btn btn-ghost\" onclick=\"limpiarFormLibro()\">Limpiar</button>\n          </div>\n        </div>\n\n        <!-- QR Preview -->\n        <div class=\"card\" style=\"display:flex; flex-direction:column; align-items:center; gap:1rem;\">\n          <div class=\"card-title\" style=\"align-self:flex-start; width:100%\">Vista previa del QR</div>\n          <div id=\"qr-preview-box\">\n            <div style=\"width:200px; height:200px; display:grid; place-items:center; color:#aaa; font-size:.75rem;\">\n              Llena el formulario →\n            </div>\n          </div>\n          <div id=\"qr-codigo-label\" style=\"font-family:var(--font-mono); font-size:.8rem; color:var(--gold); letter-spacing:.1em;\">—</div>\n          <p style=\"font-size:.72rem; color:var(--ink3); text-align:center;\">\n            Imprime este QR y pégalo en la contraportada del libro.<br>\n            El lector IoT lo escaneará durante préstamos y devoluciones.\n          </p>\n        </div>\n      </div>\n    </div>\n\n    <!-- ══════════ TAB: AUDITORÍA ══════════ -->\n    <div class=\"tab-panel\" id=\"tab-auditoria\">\n      <div class=\"section-header\">\n        <h2 class=\"section-title\">Historial de auditoría</h2>\n        <button class=\"btn btn-ghost\" onclick=\"loadAuditoria()\">↻ Actualizar</button>\n      </div>\n      <p style=\"font-size:.75rem; color:var(--ink3); margin-bottom:1rem;\">\n        Últimas 100 entradas del <code style=\"color:var(--gold)\">audit_log</code>. Para exportar: <button class=\"btn btn-ghost\" style=\"padding:.25rem .6rem; font-size:.7rem;\" onclick=\"exportarAuditoria()\">⬇ CSV</button>\n      </p>\n      <div class=\"card\">\n        <div class=\"table-wrap\">\n          <table>\n            <thead>\n              <tr><th>Fecha/Hora</th><th>Tipo</th><th>Origen</th><th>Mensaje</th></tr>\n            </thead>\n            <tbody id=\"auditoria-tbody\">\n              <tr><td colspan=\"4\" class=\"empty\"><big>🗂</big>Sin datos — activa el endpoint de auditoría</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n\n    <!-- ══════════ TAB: CONFIGURACIÓN ══════════ -->\n    <div class=\"tab-panel\" id=\"tab-config\">\n      <div class=\"section-header\">\n        <h2 class=\"section-title\">Configuración de conexiones</h2>\n      </div>\n      <p style=\"font-size:.75rem; color:var(--ink3); margin-bottom:1.5rem;\">\n        Estos valores se guardan en <code style=\"color:var(--gold)\">localStorage</code> del navegador. No se envían al servidor.\n      </p>\n\n      <div class=\"grid-2\">\n        <div class=\"card\">\n          <div class=\"card-title\">API Node-RED</div>\n          <div class=\"form-grid\" style=\"grid-template-columns:1fr;\">\n            <div class=\"field\">\n              <label>Base URL</label>\n              <input type=\"url\" id=\"cfg-api-url\" placeholder=\"http://localhost:1880\">\n            </div>\n            <div class=\"field\">\n              <label>API Key (x-api-key)</label>\n              <input type=\"password\" id=\"cfg-api-key\" placeholder=\"tu-api-key-secreta\">\n            </div>\n          </div>\n        </div>\n\n        <div class=\"card\">\n          <div class=\"card-title\">Broker MQTT (WebSocket)</div>\n          <div class=\"form-grid\" style=\"grid-template-columns:1fr 1fr;\">\n            <div class=\"field\" style=\"grid-column:1/-1\">\n              <label>Host</label>\n              <input type=\"text\" id=\"cfg-mqtt-host\" placeholder=\"localhost\">\n            </div>\n            <div class=\"field\">\n              <label>Puerto WS</label>\n              <input type=\"number\" id=\"cfg-mqtt-port\" placeholder=\"9001\">\n            </div>\n            <div class=\"field\">\n              <label>Client ID</label>\n              <input type=\"text\" id=\"cfg-mqtt-client\" placeholder=\"dashboard-ui\">\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div style=\"display:flex; gap:.75rem; margin-top:.25rem; flex-wrap:wrap;\">\n        <button class=\"btn btn-gold\" onclick=\"guardarConfig()\">💾 Guardar y reconectar</button>\n        <button class=\"btn btn-ghost\" onclick=\"resetConfig()\">Restablecer defaults</button>\n      </div>\n    </div>\n\n  </main>\n</div>\n\n<!-- ════════════════════════════════════════════\n     JAVASCRIPT\n════════════════════════════════════════════ -->\n<script>\n/* ── CONFIG (con defaults) ── */\nconst DEFAULTS = {\n  apiUrl:    'http://localhost:1880',\n  apiKey:    '',\n  mqttHost:  'localhost',\n  mqttPort:  9001,\n  mqttClient: 'dashboard-' + Math.random().toString(36).slice(2,7)\n};\n\nlet CFG = loadConfig();\nlet mqttClient = null;\nlet statsData  = null;\n\n/* ── PERSISTENCIA CONFIG ── */\nfunction loadConfig() {\n  try {\n    const saved = JSON.parse(localStorage.getItem('bibliosys_cfg') || '{}');\n    return { ...DEFAULTS, ...saved };\n  } catch { return { ...DEFAULTS }; }\n}\n\nfunction saveConfig(obj) {\n  localStorage.setItem('bibliosys_cfg', JSON.stringify(obj));\n}\n\nfunction guardarConfig() {\n  CFG.apiUrl    = document.getElementById('cfg-api-url').value   || DEFAULTS.apiUrl;\n  CFG.apiKey    = document.getElementById('cfg-api-key').value;\n  CFG.mqttHost  = document.getElementById('cfg-mqtt-host').value || DEFAULTS.mqttHost;\n  CFG.mqttPort  = parseInt(document.getElementById('cfg-mqtt-port').value) || DEFAULTS.mqttPort;\n  CFG.mqttClient = document.getElementById('cfg-mqtt-client').value || DEFAULTS.mqttClient;\n  saveConfig(CFG);\n  toast('Configuración guardada', 'ok');\n  initMQTT();\n  loadStats();\n}\n\nfunction resetConfig() {\n  CFG = { ...DEFAULTS };\n  saveConfig(CFG);\n  fillConfigForm();\n  toast('Configuración restablecida', 'warn');\n}\n\nfunction fillConfigForm() {\n  document.getElementById('cfg-api-url').value    = CFG.apiUrl;\n  document.getElementById('cfg-api-key').value    = CFG.apiKey;\n  document.getElementById('cfg-mqtt-host').value  = CFG.mqttHost;\n  document.getElementById('cfg-mqtt-port').value  = CFG.mqttPort;\n  document.getElementById('cfg-mqtt-client').value = CFG.mqttClient;\n}\n\n/* ── TABS ── */\ndocument.getElementById('main-nav').addEventListener('click', e => {\n  const btn = e.target.closest('button[data-tab]');\n  if (!btn) return;\n  document.querySelectorAll('nav button').forEach(b => b.classList.remove('active'));\n  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));\n  btn.classList.add('active');\n  document.getElementById(btn.dataset.tab).classList.add('active');\n  // Lazy load\n  if (btn.dataset.tab === 'tab-auditoria') loadAuditoria();\n});\n\n/* ── RELOJ ── */\nfunction updateClock() {\n  const now = new Date();\n  document.getElementById('clock').textContent =\n    now.toLocaleDateString('es-MX', { weekday:'short', day:'2-digit', month:'short' }) +\n    ' ' + now.toLocaleTimeString('es-MX');\n}\nsetInterval(updateClock, 1000); updateClock();\n\n/* ── TOAST ── */\nfunction toast(msg, tipo = 'ok', dur = 3500) {\n  const el = document.createElement('div');\n  el.className = `toast toast-${tipo}`;\n  el.textContent = msg;\n  document.getElementById('toast-container').appendChild(el);\n  setTimeout(() => el.remove(), dur);\n}\n\n/* ── API HELPER ── */\nasync function apiCall(path, method = 'GET', body = null) {\n  const opts = {\n    method,\n    headers: {\n      'Content-Type': 'application/json',\n      'x-api-key': CFG.apiKey\n    }\n  };\n  if (body) opts.body = JSON.stringify(body);\n  const res = await fetch(CFG.apiUrl + path, opts);\n  const data = await res.json();\n  return { ok: res.ok, status: res.status, data };\n}\n\n/* ── CARGAR ESTADÍSTICAS ── */\nasync function loadStats() {\n  setApiStatus('connecting');\n  try {\n    const { ok, data } = await apiCall('/api/stats');\n    if (!ok || !data.ok) throw new Error(data.error || 'Error API');\n\n    statsData = data;\n    const stats = data.estadisticas || {};\n    const activos = data.prestamos_activos || [];\n\n    // KPIs\n    setKpi('kpi-libros',      stats.total_libros      ?? '—');\n    setKpi('kpi-prestamos',   stats.prestamos_activos ?? activos.length);\n    setKpi('kpi-vencidos',    stats.prestamos_vencidos ?? '—');\n    setKpi('kpi-usuarios',    stats.usuarios_activos  ?? '—');\n    setKpi('kpi-disponibles', stats.ejemplares_disponibles ?? '—');\n    setKpi('kpi-ts', new Date().toLocaleTimeString('es-MX'));\n\n    // Tablas de préstamos\n    renderPrestamosTabla(activos, 'dash-prestamos-tbody', true);\n    renderPrestamosTabla(activos, 'prestamos-tbody', false);\n\n    setApiStatus('online');\n  } catch (err) {\n    setApiStatus('offline');\n    toast(`Error al cargar stats: ${err.message}`, 'err');\n    setKpi('kpi-libros', '?');\n    setKpi('kpi-prestamos', '?');\n    setKpi('kpi-vencidos', '?');\n    setKpi('kpi-usuarios', '?');\n    setKpi('kpi-disponibles', '?');\n  }\n}\n\nfunction setKpi(id, val) {\n  const el = document.getElementById(id);\n  if (el) el.textContent = val;\n}\n\nfunction renderPrestamosTabla(rows, tbodyId, mini) {\n  const tbody = document.getElementById(tbodyId);\n  if (!rows.length) {\n    tbody.innerHTML = `<tr><td colspan=\"${mini?5:7}\" class=\"empty\"><big>📚</big>Sin préstamos activos</td></tr>`;\n    return;\n  }\n  tbody.innerHTML = rows.map(r => {\n    const vencido = r.vencido == 1 || r.vencido === true;\n    const badge = vencido\n      ? '<span class=\"badge badge-red\">Vencido</span>'\n      : '<span class=\"badge badge-green\">Al corriente</span>';\n    if (mini) {\n      return `<tr>\n        <td>${esc(r.usuario_nombre || r.usuario)}</td>\n        <td>${esc(r.titulo)}</td>\n        <td>${fmtDate(r.fecha_prestamo)}</td>\n        <td>${fmtDate(r.fecha_devolucion_esperada)}</td>\n        <td>${badge}</td>\n      </tr>`;\n    } else {\n      return `<tr>\n        <td>${r.prestamo_id || r.id || '—'}</td>\n        <td>${esc(r.usuario_nombre || r.usuario)}</td>\n        <td>${esc(r.titulo)}</td>\n        <td>${esc(r.autor || '—')}</td>\n        <td>${fmtDate(r.fecha_prestamo)}</td>\n        <td>${fmtDate(r.fecha_devolucion_esperada)}</td>\n        <td>${badge}</td>\n      </tr>`;\n    }\n  }).join('');\n}\n\n/* ── CARGAR AUDITORÍA ── */\nasync function loadAuditoria() {\n  // TODO: necesitas agregar GET /api/auditoria en Node-RED\n  // SELECT * FROM audit_log ORDER BY ts DESC LIMIT 100\n  const tbody = document.getElementById('auditoria-tbody');\n  tbody.innerHTML = `<tr><td colspan=\"4\" class=\"empty\"><big>🗂</big>Endpoint <code>GET /api/auditoria</code> pendiente en Node-RED</td></tr>`;\n  toast('Endpoint /api/auditoria no implementado aún', 'warn');\n}\n\nfunction exportarAuditoria() {\n  toast('Exportar CSV requiere el endpoint /api/auditoria', 'warn');\n}\n\n/* ── MQTT ── */\nfunction initMQTT() {\n  if (mqttClient) {\n    try { mqttClient.disconnect(); } catch {}\n    mqttClient = null;\n  }\n\n  if (typeof Paho === 'undefined') {\n    setMqttStatus('offline', 'Paho no disponible');\n    return;\n  }\n\n  setMqttStatus('connecting', 'Conectando…');\n\n  mqttClient = new Paho.Client(\n    CFG.mqttHost, CFG.mqttPort, '/mqtt', CFG.mqttClient\n  );\n\n  mqttClient.onConnectionLost = ({ errorMessage }) => {\n    setMqttStatus('offline', 'Desconectado');\n    toast('MQTT desconectado: ' + errorMessage, 'err');\n    setTimeout(initMQTT, 5000);\n  };\n\n  mqttClient.onMessageArrived = (msg) => {\n    try {\n      const payload = JSON.parse(msg.payloadString);\n      appendEvent(payload);\n    } catch {\n      appendEvent({ tipo: 'raw', mensaje: msg.payloadString });\n    }\n  };\n\n  mqttClient.connect({\n    onSuccess: () => {\n      setMqttStatus('online', 'MQTT online');\n      mqttClient.subscribe('biblioteca/ui/eventos');\n      mqttClient.subscribe('biblioteca/sistema/status');\n      toast('MQTT conectado', 'ok');\n    },\n    onFailure: ({ errorMessage }) => {\n      setMqttStatus('offline', 'Sin conexión');\n      toast('MQTT error: ' + errorMessage, 'err');\n      setTimeout(initMQTT, 7000);\n    },\n    useSSL: false,\n    timeout: 5\n  });\n}\n\nfunction setMqttStatus(state, label) {\n  const dot = document.getElementById('mqtt-dot');\n  const lbl = document.getElementById('mqtt-label');\n  dot.className = 'status-dot ' + (state === 'online' ? 'online' : state === 'offline' ? 'offline' : '');\n  lbl.textContent = label;\n}\nfunction setApiStatus(state) {\n  const dot = document.getElementById('api-dot');\n  const lbl = document.getElementById('api-label');\n  dot.className = 'status-dot ' + (state === 'online' ? 'online' : state === 'offline' ? 'offline' : '');\n  lbl.textContent = state === 'online' ? 'API online' : state === 'offline' ? 'API sin respuesta' : 'API…';\n}\n\n/* ── FEED DE EVENTOS ── */\nconst ICONS = {\n  prestamo:            { icon: '📖', cls: 'prestamo'   },\n  prestamo_exitoso:    { icon: '📖', cls: 'prestamo'   },\n  devolucion:          { icon: '↩️', cls: 'devolucion' },\n  devolucion_exitosa:  { icon: '↩️', cls: 'devolucion' },\n  devolucion_tardía:   { icon: '⏰', cls: 'error'      },\n  error:               { icon: '✕',  cls: 'error'      },\n  usuario_identificado:{ icon: '👤', cls: 'usuario'    },\n  sistema:             { icon: '⚙', cls: 'sistema'    },\n};\n\nfunction appendEvent(payload) {\n  const feed = document.getElementById('event-feed');\n  // Limpiar placeholder\n  if (feed.querySelector('.empty')) feed.innerHTML = '';\n\n  const tipo  = payload.tipo || 'sistema';\n  const { icon, cls } = ICONS[tipo] || { icon: '●', cls: 'sistema' };\n  const ahora = new Date().toLocaleTimeString('es-MX');\n  const titulo = payload.mensaje || payload.error || tipo;\n  const meta   = payload.datos\n    ? Object.entries(payload.datos).slice(0,3).map(([k,v]) => `${k}: ${v}`).join(' · ')\n    : '';\n\n  const item = document.createElement('div');\n  item.className = 'event-item';\n  item.innerHTML = `\n    <div class=\"event-icon ${cls}\">${icon}</div>\n    <div class=\"event-body\">\n      <div class=\"event-title\">${esc(titulo)}</div>\n      ${meta ? `<div class=\"event-meta\">${esc(meta)}</div>` : ''}\n    </div>\n    <div class=\"event-time\">${ahora}</div>\n  `;\n  feed.prepend(item);\n\n  // Limitar a 60 items\n  while (feed.children.length > 60) feed.removeChild(feed.lastChild);\n\n  // Auto-refresh stats si es un evento relevante\n  if (['prestamo_exitoso','devolucion_exitosa','devolucion_tardía'].includes(tipo)) {\n    setTimeout(loadStats, 800);\n  }\n}\n\nfunction clearFeed() {\n  document.getElementById('event-feed').innerHTML =\n    '<div class=\"empty\"><big>📡</big>Feed limpiado — esperando eventos…</div>';\n}\n\n/* ── REGISTRAR USUARIO ── */\nfunction livePreviewUsuario() {\n  const n = v('u-nombre'), a = v('u-apellido'), e = v('u-email'),\n        t = v('u-tipo'), r = v('u-rfid'), m = v('u-maxprestamos'), vi = v('u-vigencia');\n  const obj = { nombre:n, apellido:a, email:e, tipo_usuario:t,\n                rfid_tag:r, max_prestamos:parseInt(m)||3, fecha_vigencia:vi||null };\n  document.getElementById('u-payload-preview').textContent = JSON.stringify(obj, null, 2);\n}\n['u-nombre','u-apellido','u-email','u-tipo','u-rfid','u-maxprestamos','u-vigencia']\n  .forEach(id => document.getElementById(id)?.addEventListener('input', livePreviewUsuario));\n\nasync function registrarUsuario() {\n  const nombre = v('u-nombre'), apellido = v('u-apellido'),\n        email  = v('u-email'),  rfid_tag = v('u-rfid'),\n        tipo_usuario = v('u-tipo'),\n        max_prestamos = parseInt(v('u-maxprestamos')) || 3,\n        fecha_vigencia = v('u-vigencia') || null;\n\n  if (!nombre || !apellido || !rfid_tag) {\n    toast('Nombre, apellido y RFID son obligatorios', 'err'); return;\n  }\n  if (!/^[A-F0-9]{4,16}$/.test(rfid_tag)) {\n    toast('RFID inválido (hex, 4–16 dígitos)', 'err'); return;\n  }\n\n  const payload = { nombre, apellido, email, rfid_tag, tipo_usuario, max_prestamos, fecha_vigencia };\n\n  try {\n    const { ok, data } = await apiCall('/api/usuarios', 'POST', payload);\n    if (ok && data.ok) {\n      toast(`Usuario ${nombre} ${apellido} registrado`, 'ok');\n      appendEvent({ tipo: 'usuario_identificado', mensaje: `Nuevo usuario: ${nombre} ${apellido}` });\n      limpiarFormUsuario();\n    } else {\n      toast(data.error || 'Error al registrar', 'err');\n    }\n  } catch (err) {\n    toast('Error de red: ' + err.message, 'err');\n  }\n}\n\nfunction limpiarFormUsuario() {\n  ['u-nombre','u-apellido','u-email','u-rfid','u-vigencia'].forEach(id => {\n    const el = document.getElementById(id);\n    if (el) el.value = '';\n  });\n  document.getElementById('u-tipo').value = 'estudiante';\n  document.getElementById('u-maxprestamos').value = '3';\n  document.getElementById('u-payload-preview').textContent = '—';\n}\n\n/* ── REGISTRAR LIBRO + QR ── */\nlet qrInstance = null;\n\nfunction getQRCodigo() {\n  const custom = v('l-qr');\n  if (custom) return custom.trim();\n  const isbn = v('l-isbn').replace(/[-\\s]/g,'');\n  if (isbn) return 'LIB-' + isbn.slice(-5).padStart(5,'0');\n  const titulo = v('l-titulo');\n  if (titulo) return 'LIB-' + Math.abs(hashCode(titulo)).toString().slice(0,5).padStart(5,'0');\n  return '';\n}\n\nfunction hashCode(str) {\n  let h = 0;\n  for (let i = 0; i < str.length; i++) h = Math.imul(31, h) + str.charCodeAt(i) | 0;\n  return h;\n}\n\nfunction previewQR() {\n  const codigo = getQRCodigo();\n  const box    = document.getElementById('qr-preview-box');\n  const label  = document.getElementById('qr-codigo-label');\n  label.textContent = codigo || '—';\n\n  if (!codigo) {\n    box.innerHTML = `<div style=\"width:200px;height:200px;display:grid;place-items:center;color:#aaa;font-size:.75rem;\">Llena el formulario →</div>`;\n    return;\n  }\n\n  box.innerHTML = '';\n  qrInstance = new QRCode(box, {\n    text: codigo,\n    width: 200, height: 200,\n    colorDark: '#000', colorLight: '#fff',\n    correctLevel: QRCode.CorrectLevel.H\n  });\n}\n\nfunction imprimirQR() {\n  const codigo = getQRCodigo();\n  const titulo = v('l-titulo') || 'Sin título';\n  if (!codigo) { toast('Genera primero el QR llenando el formulario', 'warn'); return; }\n\n  const qrBox = document.getElementById('qr-preview-box');\n  const canvas = qrBox.querySelector('canvas');\n  const imgSrc = canvas ? canvas.toDataURL() : (qrBox.querySelector('img')?.src || '');\n\n  const win = window.open('', '_blank');\n  win.document.write(`<!DOCTYPE html><html><head>\n    <title>QR - ${titulo}</title>\n    <style>\n      body { font-family: monospace; text-align: center; padding: 2rem; }\n      img  { display: block; margin: 0 auto 1rem; }\n      h2   { font-size: 1.1rem; margin-bottom: .25rem; }\n      p    { font-size: .85rem; color: #555; }\n      @media print { button { display: none; } }\n    </style>\n  </head><body>\n    <img src=\"${imgSrc}\" width=\"200\" height=\"200\">\n    <h2>${titulo}</h2>\n    <p>${codigo}</p>\n    <p>${v('l-autor') || ''}</p>\n    <br>\n    <button onclick=\"window.print()\">🖨 Imprimir</button>\n  </body></html>`);\n  win.document.close();\n}\n\nasync function registrarLibro() {\n  const titulo    = v('l-titulo'),\n        autor     = v('l-autor'),\n        isbn      = v('l-isbn'),\n        editorial = v('l-editorial'),\n        anio      = parseInt(v('l-anio')) || null,\n        ejemplares = parseInt(v('l-ejemplares')) || 1,\n        qr_codigo  = getQRCodigo();\n\n  if (!titulo) { toast('El título es obligatorio', 'err'); return; }\n  if (!qr_codigo) { toast('No se pudo generar el código QR', 'err'); return; }\n\n  const payload = { titulo, autor, isbn, editorial, anio, ejemplares, qr_codigo };\n\n  try {\n    const { ok, data } = await apiCall('/api/libros', 'POST', payload);\n    if (ok && data.ok) {\n      toast(`\"${titulo}\" registrado con QR ${qr_codigo}`, 'ok');\n      limpiarFormLibro();\n    } else {\n      toast(data.error || 'Error al registrar libro', 'err');\n    }\n  } catch (err) {\n    toast('Error de red: ' + err.message, 'err');\n  }\n}\n\nfunction limpiarFormLibro() {\n  ['l-titulo','l-autor','l-isbn','l-editorial','l-anio','l-qr'].forEach(id => {\n    const el = document.getElementById(id);\n    if (el) el.value = '';\n  });\n  document.getElementById('l-ejemplares').value = '1';\n  previewQR();\n}\n\n/* ── HELPERS ── */\nfunction v(id)  { return (document.getElementById(id)?.value || '').trim(); }\nfunction esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }\nfunction fmtDate(s) {\n  if (!s) return '—';\n  try { return new Date(s).toLocaleDateString('es-MX', { day:'2-digit', month:'short', year:'numeric' }); }\n  catch { return s; }\n}\n\n/* ── INIT ── */\nfillConfigForm();\ninitMQTT();\nloadStats();\n\n// Auto-refresh cada 30s\nsetInterval(loadStats, 30000);\n</script>\n</body>\n</html>",
        "output": "str",
