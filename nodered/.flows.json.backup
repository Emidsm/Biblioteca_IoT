        "name": "Query auditoría",
        "func": "\nmsg.topic = `\nSELECT\n    a.id,\n    a.timestamp,\n    a.tipo,\n    a.origen,\n    COALESCE(u.nombre || ' ' || u.apellido, '—') AS usuario,\n    a.mensaje\nFROM audit_log a\nLEFT JOIN usuarios u ON a.usuario_id = u.id\nORDER BY a.timestamp DESC\nLIMIT 100`;\nreturn msg;\n",
