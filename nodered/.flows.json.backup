    {
        "id": "fe5b8df55ff82bca",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Confirmar devolución",
        "func": "\nconst prestamo = msg.prestamo_data;\nconst ahora = new Date().toISOString().replace('T', ' ').substring(0, 19);\nconst vencido = prestamo.vencido === 1;\n\nmsg.payload = {\n    ok: true,\n    tipo: vencido ? 'devolucion_tardía' : 'devolucion_exitosa',\n    mensaje: vencido\n        ? `Devolución TARDÍA: ${prestamo.titulo}`\n        : `Devolución OK: ${prestamo.titulo}`,\n    datos: {\n        Usuario: prestamo.usuario_nombre,\n        Retraso: vencido ? `${Math.ceil((new Date().getTime() - new Date(prestamo.fecha_devolucion_esperada).getTime()) / 86400000)} días` : 'Ninguno'\n    },\n    devolucion: {\n        usuario: prestamo.usuario_nombre,\n        libro: prestamo.titulo,\n        autor: prestamo.autor,\n        fecha_devolucion_real: ahora,\n        fecha_devolucion_esperada: prestamo.fecha_devolucion_esperada\n    }\n};\nmsg.statusCode = 200;\nreturn msg;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
