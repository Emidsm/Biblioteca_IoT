        "id": "sqlite_log_backup",
        "type": "sqlite",
        "z": "tab_backup",
        "mydb": "sqlite_config",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "DB: Log de backup",
        "x": 1140,
        "y": 140,
        "wires": [
            []
        ]
    }
