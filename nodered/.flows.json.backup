    {
        "id": "4d9f409f58b1f0f0",
        "type": "template",
        "z": "3b6fce683d31f02e",
        "name": "HTML Dashboard",
        "field": "payload",
        "fieldType": "msg",
        "format": "html",
        "syntax": "html",
        "template": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>BiblioSys — Panel de Control</title>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/paho-mqtt/1.1.0/paho-mqtt.min.js\"></script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js\"></script>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,700;1,9..144,400&display=swap\" rel=\"stylesheet\">\n<style>\n:root {\n  --bg: #0f0e0b; --bg2: #181712; --bg3: #211f18;\n  --border: #2e2b22; --ink: #e8e2d4; --ink2: #9a9080; --ink3: #5a5448;\n  --gold: #c8a84b; --gold2: #8c6e28; --green: #4caf7d; --red: #d64f3c;\n  --amber: #e09b3a; --blue: #4a8fc4;\n  --font-serif: 'Fraunces', Georgia, serif;\n  --font-mono: 'DM Mono', monospace;\n  --radius: 6px;\n}\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\nhtml { font-size: 15px; }\nbody { background: var(--bg); color: var(--ink); font-family: var(--font-mono); min-height: 100vh; line-height: 1.6; }\n\n.shell { display: grid; grid-template-rows: auto auto 1fr; min-height: 100vh; }\n\n/* HEADER */\nheader {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 0 2rem; height: 56px;\n  border-bottom: 1px solid var(--border); background: var(--bg2);\n  position: sticky; top: 0; z-index: 100;\n}\n.header-brand { display: flex; align-items: center; gap: .75rem; }\n.header-brand .logo {\n  width: 32px; height: 32px; background: var(--gold);\n  clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);\n  display: grid; place-items: center; font-size: .7rem; font-weight: 500; color: var(--bg);\n}\n.header-brand h1 { font-family: var(--font-serif); font-size: 1.15rem; font-weight: 700; color: var(--ink); letter-spacing: -.02em; }\n.header-brand span { color: var(--gold); }\n.header-right { display: flex; align-items: center; gap: 1.5rem; }\n.status-pill { display: flex; align-items: center; gap: .4rem; font-size: .75rem; color: var(--ink2); }\n.status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ink3); transition: background .3s; }\n.status-dot.online  { background: var(--green); box-shadow: 0 0 6px var(--green); }\n.status-dot.offline { background: var(--red); }\n#clock { font-size: .78rem; color: var(--ink3); }\n\n/* NAV — FIJO, sin wrap */\nnav {\n  display: flex; gap: 0;\n  padding: 0 2rem;\n  background: var(--bg2);\n  border-bottom: 1px solid var(--border);\n  overflow-x: auto;\n  overflow-y: hidden;\n  white-space: nowrap;\n  height: 42px;\n  flex-shrink: 0;\n  /* Scrollbar delgada */\n  scrollbar-width: thin;\n  scrollbar-color: var(--border) transparent;\n}\nnav::-webkit-scrollbar { height: 3px; }\nnav::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }\nnav button {\n  display: inline-flex; align-items: center;\n  background: none; border: none; cursor: pointer;\n  font-family: var(--font-mono); font-size: .78rem;\n  color: var(--ink3); padding: 0 1.1rem;\n  height: 42px;\n  border-bottom: 2px solid transparent;\n  transition: color .2s, border-color .2s;\n  white-space: nowrap; flex-shrink: 0;\n}\nnav button:hover { color: var(--ink2); }\nnav button.active { color: var(--gold); border-bottom-color: var(--gold); }\n\n/* MAIN */\nmain { padding: 2rem; max-width: 1400px; margin: 0 auto; width: 100%; }\n.tab-panel { display: none; }\n.tab-panel.active { display: block; }\n\n/* CARD */\n.card { background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem 1.5rem; }\n.card-title { font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; color: var(--ink3); margin-bottom: 1rem; }\n\n/* KPIs */\n.kpi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 2rem; }\n.kpi { background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem; position: relative; overflow: hidden; transition: border-color .2s; }\n.kpi::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--accent, var(--gold)); }\n.kpi:hover { border-color: var(--accent, var(--gold)); }\n.kpi-label { font-size: .68rem; letter-spacing: .09em; text-transform: uppercase; color: var(--ink3); margin-bottom: .5rem; }\n.kpi-value { font-family: var(--font-serif); font-size: 2.2rem; font-weight: 700; line-height: 1; color: var(--accent, var(--gold)); }\n.kpi-sub { font-size: .7rem; color: var(--ink3); margin-top: .35rem; }\n\n/* TABLA */\n.table-wrap { overflow-x: auto; }\ntable { width: 100%; border-collapse: collapse; font-size: .8rem; }\nthead th { text-align: left; font-size: .65rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ink3); padding: .6rem .8rem; border-bottom: 1px solid var(--border); }\ntbody tr { border-bottom: 1px solid var(--border); transition: background .15s; }\ntbody tr:hover { background: var(--bg3); }\ntbody td { padding: .6rem .8rem; color: var(--ink2); }\ntbody td:first-child { color: var(--ink); }\n.badge { display: inline-block; padding: .15rem .5rem; border-radius: 3px; font-size: .65rem; letter-spacing: .05em; text-transform: uppercase; }\n.badge-green  { background: rgba(76,175,125,.15); color: var(--green); }\n.badge-red    { background: rgba(214,79,60,.15);  color: var(--red); }\n.badge-amber  { background: rgba(224,155,58,.15); color: var(--amber); }\n.badge-blue   { background: rgba(74,143,196,.15); color: var(--blue); }\n.badge-gold   { background: rgba(200,168,75,.15); color: var(--gold); }\n\n/* FORMS */\n.form-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; margin-bottom: 1.25rem; }\n.field { display: flex; flex-direction: column; gap: .35rem; }\n.field label { font-size: .7rem; letter-spacing: .07em; text-transform: uppercase; color: var(--ink3); }\n.field input, .field select, .field textarea { background: var(--bg3); border: 1px solid var(--border); border-radius: var(--radius); padding: .55rem .75rem; color: var(--ink); font-family: var(--font-mono); font-size: .82rem; outline: none; transition: border-color .2s; }\n.field input:focus, .field select:focus, .field textarea:focus { border-color: var(--gold); }\n.field input::placeholder { color: var(--ink3); }\n\n/* BOTONES */\n.btn { display: inline-flex; align-items: center; gap: .4rem; padding: .55rem 1.25rem; border-radius: var(--radius); font-family: var(--font-mono); font-size: .8rem; font-weight: 500; cursor: pointer; border: none; transition: opacity .2s, transform .1s; }\n.btn:active { transform: scale(.97); }\n.btn:disabled { opacity: .4; cursor: not-allowed; }\n.btn-gold   { background: var(--gold); color: var(--bg); }\n.btn-ghost  { background: transparent; border: 1px solid var(--border); color: var(--ink2); }\n.btn-ghost:hover { border-color: var(--ink2); }\n.btn-red    { background: rgba(214,79,60,.2); color: var(--red); border: 1px solid rgba(214,79,60,.3); }\n.btn-green  { background: rgba(76,175,125,.2); color: var(--green); border: 1px solid rgba(76,175,125,.3); }\n\n/* FEED */\n.event-feed { display: flex; flex-direction: column; gap: .5rem; max-height: 420px; overflow-y: auto; padding-right: .25rem; }\n.event-feed::-webkit-scrollbar { width: 4px; }\n.event-feed::-webkit-scrollbar-track { background: var(--bg3); }\n.event-feed::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }\n.event-item { display: grid; grid-template-columns: 2.5rem 1fr auto; gap: .75rem; align-items: start; padding: .75rem .9rem; background: var(--bg3); border: 1px solid var(--border); border-radius: var(--radius); animation: slideIn .25s ease; }\n@keyframes slideIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }\n.event-icon { width: 2.5rem; height: 2.5rem; border-radius: 50%; display: grid; place-items: center; font-size: 1rem; flex-shrink: 0; }\n.event-icon.prestamo   { background: rgba(76,175,125,.2);  color: var(--green); }\n.event-icon.devolucion { background: rgba(74,143,196,.2);  color: var(--blue); }\n.event-icon.error      { background: rgba(214,79,60,.2);   color: var(--red); }\n.event-icon.usuario    { background: rgba(200,168,75,.2);  color: var(--gold); }\n.event-icon.sistema    { background: rgba(90,84,72,.2);    color: var(--ink2); }\n.event-body {}\n.event-title { font-size: .82rem; color: var(--ink); margin-bottom: .15rem; }\n.event-meta  { font-size: .72rem; color: var(--ink3); }\n.event-time  { font-size: .7rem; color: var(--ink3); white-space: nowrap; }\n\n/* SECCIÓN */\n.section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }\n.section-title { font-family: var(--font-serif); font-size: 1.1rem; font-weight: 300; font-style: italic; color: var(--ink); }\n\n/* QR */\n#qr-preview-box { background: white; padding: 1rem; border-radius: var(--radius); display: inline-block; margin-top: 1rem; }\n#qr-preview-box canvas, #qr-preview-box img { display: block; }\n\n/* GRID 2 */\n.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }\n@media (max-width: 900px) { .grid-2 { grid-template-columns: 1fr; } }\n\n/* TOAST */\n#toast-container { position: fixed; bottom: 1.5rem; right: 1.5rem; display: flex; flex-direction: column-reverse; gap: .5rem; z-index: 9999; }\n.toast { padding: .75rem 1.1rem; border-radius: var(--radius); font-size: .8rem; max-width: 320px; animation: toastIn .25s ease; border-left: 3px solid; }\n@keyframes toastIn { from { opacity: 0; transform: translateX(12px); } to { opacity: 1; transform: translateX(0); } }\n.toast-ok   { background: var(--bg3); border-color: var(--green); color: var(--ink); }\n.toast-err  { background: var(--bg3); border-color: var(--red);   color: var(--ink); }\n.toast-warn { background: var(--bg3); border-color: var(--amber); color: var(--ink); }\n\n.empty { text-align: center; padding: 3rem 1rem; color: var(--ink3); font-size: .8rem; }\n.empty big { display: block; font-size: 2rem; margin-bottom: .5rem; }\n\n/* RFID banner */\n#rfid-banner {\n  display: none;\n  position: sticky; top: 56px; z-index: 90;\n  padding: .6rem 2rem;\n  background: rgba(76,175,125,.12);\n  border-bottom: 1px solid rgba(76,175,125,.3);\n  font-size: .8rem; color: var(--green);\n  align-items: center; gap: 1rem;\n}\n#rfid-banner.visible { display: flex; }\n#rfid-banner .rfid-timer { font-size: .72rem; color: var(--ink3); margin-left: auto; }\n\n/* Catálogo grid */\n.catalogo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }\n.libro-card {\n  background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius);\n  padding: 1rem; cursor: pointer; transition: border-color .2s, background .2s;\n  position: relative;\n}\n.libro-card:hover { border-color: var(--gold2); background: var(--bg3); }\n.libro-card.selected { border-color: var(--gold); background: rgba(200,168,75,.07); }\n.libro-card.sin-stock { opacity: .5; cursor: not-allowed; }\n.libro-card .libro-titulo { font-size: .88rem; color: var(--ink); font-weight: 500; margin-bottom: .25rem; }\n.libro-card .libro-autor  { font-size: .75rem; color: var(--ink3); margin-bottom: .5rem; }\n.libro-card .libro-meta   { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }\n.libro-card .disponibles-pill {\n  position: absolute; top: .7rem; right: .7rem;\n  font-size: .65rem; padding: .2rem .45rem; border-radius: 99px;\n}\n\n/* Modal de correo Gemini */\n#modal-overlay {\n  display: none; position: fixed; inset: 0;\n  background: rgba(0,0,0,.7); z-index: 1000;\n  align-items: center; justify-content: center;\n}\n#modal-overlay.visible { display: flex; }\n#modal-box {\n  background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius);\n  padding: 2rem; max-width: 600px; width: 90%; max-height: 80vh;\n  display: flex; flex-direction: column; gap: 1rem;\n}\n#modal-box h3 { font-family: var(--font-serif); font-size: 1.1rem; color: var(--ink); }\n#modal-email-content {\n  flex: 1; overflow-y: auto; background: var(--bg3);\n  border: 1px solid var(--border); border-radius: var(--radius);\n  padding: 1rem; font-size: .8rem; color: var(--ink2); white-space: pre-wrap;\n  line-height: 1.7;\n}\n</style>\n</head>\n<body>\n\n<div id=\"toast-container\"></div>\n\n<!-- Modal correo Gemini -->\n<div id=\"modal-overlay\">\n  <div id=\"modal-box\">\n    <h3>📧 Correo generado por Gemini AI</h3>\n    <p style=\"font-size:.75rem; color:var(--ink3)\">Copia este texto y envíalo al correo del usuario desde tu cliente de correo.</p>\n    <div id=\"modal-email-content\">Generando…</div>\n    <div style=\"display:flex; gap:.75rem; justify-content:flex-end;\">\n      <button class=\"btn btn-ghost\" onclick=\"copiarCorreo()\">📋 Copiar</button>\n      <button class=\"btn btn-ghost\" onclick=\"cerrarModal()\">Cerrar</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"shell\">\n  <header>\n    <div class=\"header-brand\">\n      <div class=\"logo\">📚</div>\n      <h1>Biblio<span>Sys</span></h1>\n    </div>\n    <div class=\"header-right\">\n      <div class=\"status-pill\">\n        <div class=\"status-dot\" id=\"mqtt-dot\"></div>\n        <span id=\"mqtt-label\">MQTT desconectado</span>\n      </div>\n      <div class=\"status-pill\">\n        <div class=\"status-dot\" id=\"api-dot\"></div>\n        <span id=\"api-label\">API —</span>\n      </div>\n      <span id=\"clock\">—</span>\n    </div>\n  </header>\n\n  <!-- RFID Banner -->\n  <div id=\"rfid-banner\">\n    <span>🏷️ Tag activo: <strong id=\"rfid-nombre\">—</strong></span>\n    <span id=\"rfid-cupo\" style=\"color:var(--ink2)\"></span>\n    <span class=\"rfid-timer\">Sesión válida <span id=\"rfid-countdown\">5:00</span></span>\n  </div>\n\n  <nav id=\"main-nav\">\n    <button class=\"active\" data-tab=\"tab-dashboard\">📊 Dashboard</button>\n    <button data-tab=\"tab-catalogo\">📚 Catálogo / Préstamo</button>\n    <button data-tab=\"tab-prestamos\">📖 Préstamos activos</button>\n    <button data-tab=\"tab-eventos\">⚡ Eventos en vivo</button>\n    <button data-tab=\"tab-deudores\">🚫 Deudores</button>\n    <button data-tab=\"tab-registrar-usuario\">👤 Registrar usuario</button>\n    <button data-tab=\"tab-registrar-libro\">📗 Registrar libro</button>\n    <button data-tab=\"tab-auditoria\">🗂 Auditoría</button>\n    <button data-tab=\"tab-config\">⚙️ Configuración</button>\n  </nav>\n\n  <main>\n\n    <!-- ══════════ DASHBOARD ══════════ -->\n    <div class=\"tab-panel active\" id=\"tab-dashboard\">\n      <div class=\"section-header\" style=\"margin-bottom:1.5rem\">\n        <h2 class=\"section-title\">Resumen del sistema</h2>\n        <button class=\"btn btn-ghost\" onclick=\"loadStats()\">↻ Actualizar</button>\n      </div>\n      <div class=\"kpi-grid\">\n        <div class=\"kpi\" style=\"--accent:var(--gold)\"><div class=\"kpi-label\">Libros totales</div><div class=\"kpi-value\" id=\"kpi-libros\">—</div><div class=\"kpi-sub\">en catálogo</div></div>\n        <div class=\"kpi\" style=\"--accent:var(--blue)\"><div class=\"kpi-label\">Préstamos activos</div><div class=\"kpi-value\" id=\"kpi-prestamos\">—</div><div class=\"kpi-sub\">en circulación</div></div>\n        <div class=\"kpi\" style=\"--accent:var(--red)\"><div class=\"kpi-label\">Vencidos</div><div class=\"kpi-value\" id=\"kpi-vencidos\">—</div><div class=\"kpi-sub\">fuera de fecha</div></div>\n        <div class=\"kpi\" style=\"--accent:var(--green)\"><div class=\"kpi-label\">Usuarios activos</div><div class=\"kpi-value\" id=\"kpi-usuarios\">—</div><div class=\"kpi-sub\">registrados</div></div>\n        <div class=\"kpi\" style=\"--accent:var(--amber)\"><div class=\"kpi-label\">Ejemplares disp.</div><div class=\"kpi-value\" id=\"kpi-disponibles\">—</div><div class=\"kpi-sub\">listos para prestar</div></div>\n        <div class=\"kpi\" style=\"--accent:var(--ink2)\"><div class=\"kpi-label\">Última actualiz.</div><div class=\"kpi-value\" id=\"kpi-ts\" style=\"font-size:1rem; padding-top:.5rem\">—</div><div class=\"kpi-sub\">&nbsp;</div></div>\n      </div>\n      <div class=\"card\">\n        <div class=\"card-title\">Préstamos activos — próximos a vencer primero</div>\n        <div class=\"table-wrap\">\n          <table>\n            <thead><tr><th>Usuario</th><th>Libro</th><th>Desde</th><th>Vence</th><th>Estado</th></tr></thead>\n            <tbody id=\"dash-prestamos-tbody\"><tr><td colspan=\"5\" class=\"empty\"><big>📂</big>Cargando…</td></tr></tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n\n    <!-- ══════════ CATÁLOGO / PRÉSTAMO ══════════ -->\n    <div class=\"tab-panel\" id=\"tab-catalogo\">\n      <div class=\"section-header\">\n        <h2 class=\"section-title\">Catálogo — Seleccionar para prestar</h2>\n        <div style=\"display:flex; gap:.75rem;\">\n          <button class=\"btn btn-ghost\" onclick=\"loadCatalogo()\">↻ Actualizar</button>\n          <button class=\"btn btn-green\" id=\"btn-prestar\" disabled onclick=\"ejecutarPrestamo()\">📖 Prestar libro seleccionado</button>\n        </div>\n      </div>\n\n      <!-- Instrucciones -->\n      <div style=\"background:rgba(74,143,196,.08); border:1px solid rgba(74,143,196,.25); border-radius:var(--radius); padding:.75rem 1rem; margin-bottom:1.5rem; font-size:.8rem; color:var(--blue);\">\n        <strong>Cómo prestar:</strong> 1) El estudiante acerca su tarjeta RFID al lector → 2) Aparece su nombre en la barra verde de arriba → 3) Selecciona un libro disponible → 4) Haz clic en <em>Prestar libro seleccionado</em>.\n      </div>\n\n      <!-- Filtros -->\n      <div style=\"display:flex; gap:.75rem; margin-bottom:1.25rem; flex-wrap:wrap; align-items:center;\">\n        <div class=\"field\" style=\"flex:1; min-width:200px;\">\n          <input type=\"text\" id=\"catalogo-search\" placeholder=\"🔍 Buscar título, autor, ISBN…\" oninput=\"filtrarCatalogo()\" style=\"background:var(--bg3); border:1px solid var(--border); border-radius:var(--radius); padding:.55rem .75rem; color:var(--ink); font-family:var(--font-mono); font-size:.82rem; outline:none; width:100%;\">\n        </div>\n        <select id=\"catalogo-genero\" onchange=\"filtrarCatalogo()\" style=\"background:var(--bg3); border:1px solid var(--border); border-radius:var(--radius); padding:.55rem .75rem; color:var(--ink); font-family:var(--font-mono); font-size:.8rem; outline:none;\">\n          <option value=\"\">Todos los géneros</option>\n        </select>\n        <label style=\"font-size:.75rem; color:var(--ink3); display:flex; align-items:center; gap:.35rem; cursor:pointer;\">\n          <input type=\"checkbox\" id=\"solo-disponibles\" onchange=\"filtrarCatalogo()\" checked> Solo disponibles\n        </label>\n      </div>\n\n      <div class=\"catalogo-grid\" id=\"catalogo-grid\">\n        <div class=\"empty\" style=\"grid-column:1/-1\"><big>📚</big>Cargando catálogo…</div>\n      </div>\n    </div>\n\n    <!-- ══════════ PRÉSTAMOS ACTIVOS ══════════ -->\n    <div class=\"tab-panel\" id=\"tab-prestamos\">\n      <div class=\"section-header\">\n        <h2 class=\"section-title\">Préstamos activos</h2>\n        <button class=\"btn btn-ghost\" onclick=\"loadStats()\">↻ Actualizar</button>\n      </div>\n      <div class=\"card\">\n        <div class=\"table-wrap\">\n          <table>\n            <thead><tr><th>#</th><th>Usuario</th><th>Libro</th><th>Autor</th><th>F. Préstamo</th><th>F. Devolución</th><th>Estado</th><th>Acción</th></tr></thead>\n            <tbody id=\"prestamos-tbody\"><tr><td colspan=\"8\" class=\"empty\"><big>📂</big>Sin datos</td></tr></tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n\n    <!-- ══════════ EVENTOS EN VIVO ══════════ -->\n    <div class=\"tab-panel\" id=\"tab-eventos\">\n      <div class=\"section-header\">\n        <h2 class=\"section-title\">Feed de eventos MQTT</h2>\n        <button class=\"btn btn-ghost btn-red\" onclick=\"clearFeed()\">🗑 Limpiar</button>\n      </div>\n      <p style=\"font-size:.75rem; color:var(--ink3); margin-bottom:1rem;\">\n        Suscrito a <code style=\"color:var(--gold)\">biblioteca/ui/eventos</code> — eventos en tiempo real.\n      </p>\n      <div class=\"event-feed\" id=\"event-feed\">\n        <div class=\"empty\"><big>📡</big>Esperando eventos MQTT…</div>\n      </div>\n    </div>\n\n    <!-- ══════════ DEUDORES ══════════ -->\n    <div class=\"tab-panel\" id=\"tab-deudores\">\n      <div class=\"section-header\">\n        <h2 class=\"section-title\">Deudores — Préstamos vencidos</h2>\n        <button class=\"btn btn-ghost\" onclick=\"loadDeudores()\">↻ Actualizar</button>\n      </div>\n      <p style=\"font-size:.75rem; color:var(--ink3); margin-bottom:1rem;\">\n        Usuarios con préstamos fuera de fecha. El botón <strong style=\"color:var(--red)\">Banear</strong> suspende el acceso del usuario y genera un correo personalizado con Gemini AI.\n      </p>\n      <div style=\"background:rgba(224,155,58,.08); border:1px solid rgba(224,155,58,.2); border-radius:var(--radius); padding:.75rem 1rem; margin-bottom:1.5rem; font-size:.75rem; color:var(--amber);\">\n        ⚠️ Configura tu <strong>GEMINI_API_KEY</strong> en Settings → Environment Variables de Node-RED para activar la generación de correos.\n      </div>\n      <div class=\"card\">\n        <div class=\"table-wrap\">\n          <table>\n            <thead><tr><th>Nombre</th><th>Email</th><th>Tipo</th><th>Libros vencidos</th><th>Títulos</th><th>Vencido desde</th><th>Acción</th></tr></thead>\n            <tbody id=\"deudores-tbody\"><tr><td colspan=\"7\" class=\"empty\"><big>✅</big>Sin deudores activos</td></tr></tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n\n    <!-- ══════════ REGISTRAR USUARIO ══════════ -->\n    <div class=\"tab-panel\" id=\"tab-registrar-usuario\">\n      <div class=\"section-header\"><h2 class=\"section-title\">Registrar nuevo usuario</h2></div>\n      <div class=\"grid-2\">\n        <div class=\"card\">\n          <div class=\"card-title\">Datos personales</div>\n          <div class=\"form-grid\">\n            <div class=\"field\"><label>Nombre</label><input type=\"text\" id=\"u-nombre\" placeholder=\"María\"></div>\n            <div class=\"field\"><label>Apellido</label><input type=\"text\" id=\"u-apellido\" placeholder=\"García López\"></div>\n            <div class=\"field\"><label>Email</label><input type=\"email\" id=\"u-email\" placeholder=\"maria@escuela.edu\"></div>\n            <div class=\"field\"><label>Tipo de usuario</label><select id=\"u-tipo\"><option value=\"estudiante\">Estudiante</option><option value=\"docente\">Docente</option><option value=\"administrativo\">Personal administrativo</option></select></div>\n            <div class=\"field\"><label>Máx. préstamos</label><input type=\"number\" id=\"u-maxprestamos\" value=\"3\" min=\"1\" max=\"10\"></div>\n            <div class=\"field\"><label>Vigencia (fecha)</label><input type=\"date\" id=\"u-vigencia\"></div>\n          </div>\n          <div class=\"card-title\" style=\"margin-top:.5rem\">Tag RFID</div>\n          <div class=\"form-grid\">\n            <div class=\"field\"><label>UID del tag (hex)</label><input type=\"text\" id=\"u-rfid\" placeholder=\"A1B2C3D4\" maxlength=\"16\" oninput=\"this.value=this.value.toUpperCase().replace(/[^A-F0-9]/g,'')\"></div>\n          </div>\n          <div style=\"display:flex; gap:.75rem; flex-wrap:wrap;\">\n            <button class=\"btn btn-gold\" onclick=\"registrarUsuario()\">✚ Registrar usuario</button>\n            <button class=\"btn btn-ghost\" onclick=\"limpiarFormUsuario()\">Limpiar</button>\n          </div>\n        </div>\n        <div class=\"card\">\n          <div class=\"card-title\">Cómo asignar el tag RFID</div>\n          <div style=\"font-size:.8rem; color:var(--ink2); line-height:1.9;\">\n            <p>1. Acerca el lector RFID al tag del usuario.</p>\n            <p>2. El UID aparece en el monitor serial o en el feed de eventos MQTT.</p>\n            <p>3. Cópialo en el campo <em>UID del tag</em>.</p>\n            <p>4. Haz clic en <strong style=\"color:var(--gold)\">Registrar usuario</strong>.</p>\n          </div>\n          <hr style=\"border-color:var(--border); margin:1rem 0;\">\n          <div class=\"card-title\">Vista previa del payload</div>\n          <pre id=\"u-payload-preview\" style=\"font-size:.72rem; color:var(--ink3); white-space:pre-wrap; word-break:break-all;\">—</pre>\n        </div>\n      </div>\n    </div>\n\n    <!-- ══════════ REGISTRAR LIBRO ══════════ -->\n    <div class=\"tab-panel\" id=\"tab-registrar-libro\">\n      <div class=\"section-header\"><h2 class=\"section-title\">Registrar libro y generar QR</h2></div>\n      <div class=\"grid-2\">\n        <div class=\"card\">\n          <div class=\"card-title\">Datos del libro</div>\n          <div class=\"form-grid\">\n            <div class=\"field\" style=\"grid-column:1/-1\"><label>Título</label><input type=\"text\" id=\"l-titulo\" placeholder=\"Cien Años de Soledad\" oninput=\"previewQR()\"></div>\n            <div class=\"field\"><label>Autor</label><input type=\"text\" id=\"l-autor\" placeholder=\"Gabriel García Márquez\"></div>\n            <div class=\"field\"><label>ISBN</label><input type=\"text\" id=\"l-isbn\" placeholder=\"978-0-06-088328-7\" oninput=\"previewQR()\"></div>\n            <div class=\"field\"><label>Editorial</label><input type=\"text\" id=\"l-editorial\" placeholder=\"Harper Collins\"></div>\n            <div class=\"field\"><label>Año</label><input type=\"number\" id=\"l-anio\" placeholder=\"2004\"></div>\n            <div class=\"field\"><label>Número de ejemplares</label><input type=\"number\" id=\"l-ejemplares\" value=\"1\" min=\"1\" max=\"50\"></div>\n            <div class=\"field\"><label>Código QR (vacío = auto)</label><input type=\"text\" id=\"l-qr\" placeholder=\"LIB-00042\" maxlength=\"12\" oninput=\"previewQR()\"></div>\n          </div>\n          <div style=\"display:flex; gap:.75rem; flex-wrap:wrap;\">\n            <button class=\"btn btn-gold\" onclick=\"registrarLibro()\">✚ Registrar libro</button>\n            <button class=\"btn btn-ghost\" onclick=\"imprimirQR()\">🖨 Imprimir QR</button>\n            <button class=\"btn btn-ghost\" onclick=\"limpiarFormLibro()\">Limpiar</button>\n          </div>\n        </div>\n        <div class=\"card\" style=\"display:flex; flex-direction:column; align-items:center; gap:1rem;\">\n          <div class=\"card-title\" style=\"align-self:flex-start; width:100%\">Vista previa del QR</div>\n          <div id=\"qr-preview-box\"><div style=\"width:200px;height:200px;display:grid;place-items:center;color:#aaa;font-size:.75rem;\">Llena el formulario →</div></div>\n          <div id=\"qr-codigo-label\" style=\"font-family:var(--font-mono);font-size:.8rem;color:var(--gold);letter-spacing:.1em;\">—</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- ══════════ AUDITORÍA ══════════ -->\n    <div class=\"tab-panel\" id=\"tab-auditoria\">\n      <div class=\"section-header\">\n        <h2 class=\"section-title\">Historial de auditoría</h2>\n        <div style=\"display:flex; gap:.75rem;\">\n          <button class=\"btn btn-ghost\" onclick=\"loadAuditoria()\">↻ Actualizar</button>\n          <button class=\"btn btn-ghost\" style=\"font-size:.7rem;\" onclick=\"exportarAuditoria()\">⬇ CSV</button>\n        </div>\n      </div>\n      <div class=\"card\">\n        <div class=\"table-wrap\">\n          <table>\n            <thead><tr><th>Fecha/Hora</th><th>Tipo</th><th>Origen</th><th>Usuario</th><th>Mensaje</th></tr></thead>\n            <tbody id=\"auditoria-tbody\"><tr><td colspan=\"5\" class=\"empty\"><big>🗂</big>Cargando…</td></tr></tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n\n    <!-- ══════════ CONFIGURACIÓN ══════════ -->\n    <div class=\"tab-panel\" id=\"tab-config\">\n      <div class=\"section-header\"><h2 class=\"section-title\">Configuración de conexiones</h2></div>\n      <p style=\"font-size:.75rem; color:var(--ink3); margin-bottom:1.5rem;\">\n        Estos valores se guardan en <code style=\"color:var(--gold)\">localStorage</code>. No se envían al servidor.\n      </p>\n      <div class=\"grid-2\">\n        <div class=\"card\">\n          <div class=\"card-title\">API Node-RED</div>\n          <div class=\"form-grid\" style=\"grid-template-columns:1fr;\">\n            <div class=\"field\"><label>Base URL</label><input type=\"url\" id=\"cfg-api-url\" placeholder=\"http://localhost:1880\"></div>\n            <div class=\"field\"><label>API Key (x-api-key)</label><input type=\"password\" id=\"cfg-api-key\" placeholder=\"tu-api-key-secreta\"></div>\n          </div>\n        </div>\n        <div class=\"card\">\n          <div class=\"card-title\">Broker MQTT (WebSocket)</div>\n          <div class=\"form-grid\" style=\"grid-template-columns:1fr 1fr;\">\n            <div class=\"field\" style=\"grid-column:1/-1\"><label>Host</label><input type=\"text\" id=\"cfg-mqtt-host\" placeholder=\"localhost\"></div>\n            <div class=\"field\"><label>Puerto WS</label><input type=\"number\" id=\"cfg-mqtt-port\" placeholder=\"9001\"></div>\n            <div class=\"field\"><label>Client ID</label><input type=\"text\" id=\"cfg-mqtt-client\" placeholder=\"dashboard-ui\"></div>\n          </div>\n        </div>\n      </div>\n      <div style=\"display:flex; gap:.75rem; margin-top:.25rem; flex-wrap:wrap;\">\n        <button class=\"btn btn-gold\" onclick=\"guardarConfig()\">💾 Guardar y reconectar</button>\n        <button class=\"btn btn-ghost\" onclick=\"resetConfig()\">Restablecer defaults</button>\n      </div>\n    </div>\n\n  </main>\n</div>\n\n<script>\n/* ── CONFIG ── */\nconst DEFAULTS = {\n  apiUrl: 'http://localhost:1880', apiKey: '',\n  mqttHost: 'localhost', mqttPort: 9001,\n  mqttClient: 'dashboard-' + Math.random().toString(36).slice(2,7)\n};\nlet CFG = loadConfig();\nlet mqttClient = null;\nlet catalogoData = [];\nlet libroSeleccionado = null;\nlet rfidTimer = null;\nlet rfidSecondsLeft = 0;\n\nfunction loadConfig() {\n  try { return { ...DEFAULTS, ...JSON.parse(localStorage.getItem('bibliosys_cfg') || '{}') }; }\n  catch { return { ...DEFAULTS }; }\n}\nfunction saveConfig(o) { localStorage.setItem('bibliosys_cfg', JSON.stringify(o)); }\n\nfunction guardarConfig() {\n  CFG.apiUrl   = document.getElementById('cfg-api-url').value   || DEFAULTS.apiUrl;\n  CFG.apiKey   = document.getElementById('cfg-api-key').value;\n  CFG.mqttHost = document.getElementById('cfg-mqtt-host').value || DEFAULTS.mqttHost;\n  CFG.mqttPort = parseInt(document.getElementById('cfg-mqtt-port').value) || DEFAULTS.mqttPort;\n  CFG.mqttClient = document.getElementById('cfg-mqtt-client').value || DEFAULTS.mqttClient;\n  saveConfig(CFG); toast('Configuración guardada', 'ok'); initMQTT(); loadStats();\n}\nfunction resetConfig() { CFG = { ...DEFAULTS }; saveConfig(CFG); fillConfigForm(); toast('Configuración restablecida', 'warn'); }\nfunction fillConfigForm() {\n  document.getElementById('cfg-api-url').value    = CFG.apiUrl;\n  document.getElementById('cfg-api-key').value    = CFG.apiKey;\n  document.getElementById('cfg-mqtt-host').value  = CFG.mqttHost;\n  document.getElementById('cfg-mqtt-port').value  = CFG.mqttPort;\n  document.getElementById('cfg-mqtt-client').value = CFG.mqttClient;\n}\n\n/* ── TABS ── */\ndocument.getElementById('main-nav').addEventListener('click', e => {\n  const btn = e.target.closest('button[data-tab]');\n  if (!btn) return;\n  document.querySelectorAll('nav button').forEach(b => b.classList.remove('active'));\n  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));\n  btn.classList.add('active');\n  document.getElementById(btn.dataset.tab).classList.add('active');\n  if (btn.dataset.tab === 'tab-auditoria') loadAuditoria();\n  if (btn.dataset.tab === 'tab-deudores')  loadDeudores();\n  if (btn.dataset.tab === 'tab-catalogo')  loadCatalogo();\n});\n\n/* ── RELOJ ── */\nfunction updateClock() {\n  const now = new Date();\n  document.getElementById('clock').textContent =\n    now.toLocaleDateString('es-MX', { weekday:'short', day:'2-digit', month:'short' }) + ' ' +\n    now.toLocaleTimeString('es-MX');\n}\nsetInterval(updateClock, 1000); updateClock();\n\n/* ── TOAST ── */\nfunction toast(msg, tipo = 'ok', dur = 3500) {\n  const el = document.createElement('div');\n  el.className = `toast toast-${tipo}`;\n  el.textContent = msg;\n  document.getElementById('toast-container').appendChild(el);\n  setTimeout(() => el.remove(), dur);\n}\n\n/* ── API ── */\nasync function apiCall(path, method = 'GET', body = null) {\n  const opts = { method, headers: { 'Content-Type': 'application/json', 'x-api-key': CFG.apiKey } };\n  if (body) opts.body = JSON.stringify(body);\n  const res = await fetch(CFG.apiUrl + path, opts);\n  const data = await res.json();\n  return { ok: res.ok, status: res.status, data };\n}\n\n/* ── RFID BANNER ── */\nfunction activarRfidBanner(usuario) {\n  const banner = document.getElementById('rfid-banner');\n  document.getElementById('rfid-nombre').textContent =\n    (usuario.nombre || '—') + (usuario.cupo !== undefined ? '' : '');\n  document.getElementById('rfid-cupo').textContent =\n    usuario.cupo !== undefined ? `Cupo disponible: ${usuario.cupo}` : '';\n  banner.classList.add('visible');\n\n  if (rfidTimer) clearInterval(rfidTimer);\n  rfidSecondsLeft = 300;\n\n  rfidTimer = setInterval(() => {\n    rfidSecondsLeft--;\n    const m = Math.floor(rfidSecondsLeft / 60);\n    const s = String(rfidSecondsLeft % 60).padStart(2, '0');\n    document.getElementById('rfid-countdown').textContent = `${m}:${s}`;\n    if (rfidSecondsLeft <= 0) {\n      clearInterval(rfidTimer);\n      banner.classList.remove('visible');\n      toast('Sesión RFID expirada', 'warn');\n      libroSeleccionado = null;\n      actualizarBotonPrestar();\n    }\n  }, 1000);\n}\n\n/* ── ESTADÍSTICAS ── */\nasync function loadStats() {\n  setApiStatus('connecting');\n  try {\n    const { ok, data } = await apiCall('/api/stats');\n    if (!ok || !data.ok) throw new Error(data.error || 'Error API');\n    const stats = data.estadisticas || {};\n    const activos = data.prestamos_activos || [];\n    setKpi('kpi-libros',      stats.total_libros           ?? '—');\n    setKpi('kpi-prestamos',   stats.prestamos_activos      ?? activos.length);\n    setKpi('kpi-vencidos',    stats.prestamos_vencidos     ?? '—');\n    setKpi('kpi-usuarios',    stats.total_usuarios         ?? '—');\n    setKpi('kpi-disponibles', stats.ejemplares_disponibles ?? '—');\n    setKpi('kpi-ts', new Date().toLocaleTimeString('es-MX'));\n    renderPrestamosTabla(activos, 'dash-prestamos-tbody', true);\n    renderPrestamosTabla(activos, 'prestamos-tbody', false);\n    setApiStatus('online');\n  } catch(err) {\n    setApiStatus('offline');\n    toast(`Error al cargar stats: ${err.message}`, 'err');\n  }\n}\n\nfunction setKpi(id, val) { const el = document.getElementById(id); if (el) el.textContent = val; }\n\nfunction renderPrestamosTabla(rows, tbodyId, mini) {\n  const tbody = document.getElementById(tbodyId);\n  if (!rows || !rows.length) {\n    tbody.innerHTML = `<tr><td colspan=\"${mini?5:8}\" class=\"empty\"><big>📚</big>Sin préstamos activos</td></tr>`;\n    return;\n  }\n  tbody.innerHTML = rows.map(r => {\n    const vencido = r.vencido == 1 || r.vencido === true;\n    const badge = vencido\n      ? '<span class=\"badge badge-red\">Vencido</span>'\n      : '<span class=\"badge badge-green\">Al corriente</span>';\n    if (mini) {\n      return `<tr>\n        <td>${esc(r.usuario_nombre || r.usuario)}</td>\n        <td>${esc(r.titulo)}</td>\n        <td>${fmtDate(r.fecha_prestamo)}</td>\n        <td>${fmtDate(r.fecha_devolucion_esperada)}</td>\n        <td>${badge}</td>\n      </tr>`;\n    } else {\n      const btnDev = `<button class=\"btn btn-ghost\" style=\"padding:.25rem .6rem;font-size:.7rem;\" onclick=\"devolverPrestamo(${r.prestamo_id})\">↩ Devolver</button>`;\n      return `<tr>\n        <td>${r.prestamo_id || '—'}</td>\n        <td>${esc(r.usuario_nombre || r.usuario)}</td>\n        <td>${esc(r.titulo)}</td>\n        <td>${esc(r.autor || '—')}</td>\n        <td>${fmtDate(r.fecha_prestamo)}</td>\n        <td>${fmtDate(r.fecha_devolucion_esperada)}</td>\n        <td>${badge}</td>\n        <td>${btnDev}</td>\n      </tr>`;\n    }\n  }).join('');\n}\n\nasync function devolverPrestamo(prestamo_id) {\n  const rfid = prompt('Ingresa el RFID del usuario para confirmar la devolución:');\n  if (!rfid) return;\n  try {\n    const { ok, data } = await apiCall('/api/rfid/scan', 'POST', {\n      tipo: 'devolucion',\n      rfid_tag: rfid.trim().toUpperCase(),\n      prestamo_id: prestamo_id\n    });\n    if (ok && data.ok) {\n      toast(data.mensaje || 'Devolución registrada', 'ok');\n      loadStats();\n    } else {\n      toast(data.error || data.mensaje || 'Error en devolución', 'err');\n    }\n  } catch(e) { toast('Error de red: ' + e.message, 'err'); }\n}\n\n/* ── CATÁLOGO ── */\nasync function loadCatalogo() {\n  const grid = document.getElementById('catalogo-grid');\n  grid.innerHTML = '<div class=\"empty\" style=\"grid-column:1/-1\"><big>⏳</big>Cargando…</div>';\n  try {\n    const { ok, data } = await apiCall('/api/catalogo');\n    if (!ok || !data.ok) throw new Error('Error al cargar catálogo');\n    catalogoData = data.libros || [];\n\n    // Poblar géneros\n    const generos = [...new Set(catalogoData.map(l => l.genero).filter(Boolean))].sort();\n    const sel = document.getElementById('catalogo-genero');\n    const valActual = sel.value;\n    sel.innerHTML = '<option value=\"\">Todos los géneros</option>' +\n      generos.map(g => `<option value=\"${esc(g)}\"${g === valActual ? ' selected' : ''}>${esc(g)}</option>`).join('');\n\n    filtrarCatalogo();\n  } catch(e) {\n    grid.innerHTML = `<div class=\"empty\" style=\"grid-column:1/-1\"><big>⚠️</big>${e.message}</div>`;\n  }\n}\n\nfunction filtrarCatalogo() {\n  const q = document.getElementById('catalogo-search').value.toLowerCase();\n  const genero = document.getElementById('catalogo-genero').value;\n  const soloDisp = document.getElementById('solo-disponibles').checked;\n\n  const filtrados = catalogoData.filter(l => {\n    if (soloDisp && l.disponibles < 1) return false;\n    if (genero && l.genero !== genero) return false;\n    if (q && !`${l.titulo} ${l.autor} ${l.isbn || ''} ${l.editorial || ''}`.toLowerCase().includes(q)) return false;\n    return true;\n  });\n\n  renderCatalogo(filtrados);\n}\n\nfunction renderCatalogo(libros) {\n  const grid = document.getElementById('catalogo-grid');\n  if (!libros.length) {\n    grid.innerHTML = '<div class=\"empty\" style=\"grid-column:1/-1\"><big>🔍</big>Sin resultados</div>';\n    return;\n  }\n  grid.innerHTML = libros.map(l => {\n    const disp = l.disponibles || 0;\n    const sin = disp < 1;\n    const sel = libroSeleccionado && libroSeleccionado.id === l.id;\n    const dispClass = sin ? 'badge-red' : (disp <= 1 ? 'badge-amber' : 'badge-green');\n    return `<div class=\"libro-card ${sin ? 'sin-stock' : ''} ${sel ? 'selected' : ''}\"\n                 onclick=\"${sin ? '' : `seleccionarLibro(${l.id})`}\"\n                 data-libro-id=\"${l.id}\">\n      <span class=\"badge ${dispClass} disponibles-pill\">${disp} disp.</span>\n      <div class=\"libro-titulo\">${esc(l.titulo)}</div>\n      <div class=\"libro-autor\">${esc(l.autor)}</div>\n      <div class=\"libro-meta\">\n        ${l.genero ? `<span class=\"badge badge-blue\">${esc(l.genero)}</span>` : ''}\n        ${l.anio_publicacion ? `<span style=\"font-size:.68rem;color:var(--ink3)\">${l.anio_publicacion}</span>` : ''}\n        ${l.ubicacion ? `<span style=\"font-size:.68rem;color:var(--ink3)\">📍 ${esc(l.ubicacion)}</span>` : ''}\n      </div>\n    </div>`;\n  }).join('');\n}\n\nfunction seleccionarLibro(id) {\n  libroSeleccionado = catalogoData.find(l => l.id === id) || null;\n  document.querySelectorAll('.libro-card').forEach(c => {\n    c.classList.toggle('selected', parseInt(c.dataset.libroId) === id);\n  });\n  actualizarBotonPrestar();\n  if (libroSeleccionado) {\n    toast(`\"${libroSeleccionado.titulo}\" seleccionado`, 'ok', 2000);\n  }\n}\n\nfunction actualizarBotonPrestar() {\n  const btn = document.getElementById('btn-prestar');\n  const banner = document.getElementById('rfid-banner');\n  const rfidActivo = banner.classList.contains('visible');\n  btn.disabled = !(libroSeleccionado && rfidActivo);\n  btn.textContent = libroSeleccionado\n    ? `📖 Prestar \"${libroSeleccionado.titulo.substring(0,30)}${libroSeleccionado.titulo.length > 30 ? '…' : ''}\"`\n    : '📖 Prestar libro seleccionado';\n}\n\nasync function ejecutarPrestamo() {\n  if (!libroSeleccionado) { toast('Selecciona un libro primero', 'warn'); return; }\n  const banner = document.getElementById('rfid-banner');\n  if (!banner.classList.contains('visible')) {\n    toast('No hay sesión RFID activa. Acerca tu tarjeta al lector.', 'err'); return;\n  }\n\n  const btn = document.getElementById('btn-prestar');\n  btn.disabled = true;\n  btn.textContent = '⏳ Procesando…';\n\n  try {\n    const { ok, data } = await apiCall('/api/prestamo/web', 'POST', { libro_id: libroSeleccionado.id });\n    if (ok && data.ok) {\n      toast(data.mensaje || 'Préstamo registrado', 'ok');\n      appendEvent({ tipo: 'prestamo_exitoso', mensaje: data.mensaje, datos: data.prestamo });\n      libroSeleccionado = null;\n      loadCatalogo();\n      loadStats();\n    } else {\n      toast(data.mensaje || data.error || 'Error al procesar préstamo', 'err');\n    }\n  } catch(e) { toast('Error de red: ' + e.message, 'err'); }\n\n  btn.disabled = false;\n  actualizarBotonPrestar();\n}\n\n/* ── AUDITORÍA ── */\nasync function loadAuditoria() {\n  const tbody = document.getElementById('auditoria-tbody');\n  tbody.innerHTML = '<tr><td colspan=\"5\" class=\"empty\"><big>⏳</big>Cargando…</td></tr>';\n  try {\n    const { ok, data } = await apiCall('/api/auditoria');\n    if (!ok || !data.ok) throw new Error('Error cargando auditoría');\n    const rows = data.registros || [];\n    if (!rows.length) {\n      tbody.innerHTML = '<tr><td colspan=\"5\" class=\"empty\"><big>🗂</big>Sin registros</td></tr>';\n      return;\n    }\n    const tipoBadge = {\n      prestamo:   'badge-green', devolucion: 'badge-blue',\n      error:      'badge-red',   backup:     'badge-gold',\n      baneo:      'badge-red',   login:      'badge-amber'\n    };\n    tbody.innerHTML = rows.map(r =>\n      `<tr>\n        <td style=\"white-space:nowrap\">${esc(r.timestamp)}</td>\n        <td><span class=\"badge ${tipoBadge[r.tipo] || 'badge-amber'}\">${esc(r.tipo)}</span></td>\n        <td><span class=\"badge badge-gold\" style=\"font-size:.6rem\">${esc(r.origen)}</span></td>\n        <td>${esc(r.usuario)}</td>\n        <td>${esc(r.mensaje)}</td>\n      </tr>`\n    ).join('');\n  } catch(e) {\n    tbody.innerHTML = `<tr><td colspan=\"5\" class=\"empty\"><big>⚠️</big>${e.message}</td></tr>`;\n    toast(e.message, 'err');\n  }\n}\n\nfunction exportarAuditoria() {\n  const tbody = document.getElementById('auditoria-tbody');\n  const rows = Array.from(tbody.querySelectorAll('tr')).map(tr =>\n    Array.from(tr.querySelectorAll('td')).map(td => `\"${td.textContent.replace(/\"/g,'\"\"')}\"`).join(',')\n  ).filter(Boolean);\n  if (!rows.length) { toast('Sin datos para exportar', 'warn'); return; }\n  const csv = 'Fecha/Hora,Tipo,Origen,Usuario,Mensaje\\n' + rows.join('\\n');\n  const a = document.createElement('a');\n  a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csv);\n  a.download = `auditoria_${new Date().toISOString().substring(0,10)}.csv`;\n  a.click();\n}\n\n/* ── DEUDORES ── */\nasync function loadDeudores() {\n  const tbody = document.getElementById('deudores-tbody');\n  tbody.innerHTML = '<tr><td colspan=\"7\" class=\"empty\"><big>⏳</big>Cargando…</td></tr>';\n  try {\n    const { ok, data } = await apiCall('/api/deudores');\n    if (!ok || !data.ok) throw new Error('Error cargando deudores');\n    const rows = data.deudores || [];\n    if (!rows.length) {\n      tbody.innerHTML = '<tr><td colspan=\"7\" class=\"empty\"><big>✅</big>¡Sin deudores! Todos al corriente.</td></tr>';\n      return;\n    }\n    tbody.innerHTML = rows.map(d => `<tr>\n      <td>${esc(d.nombre + ' ' + d.apellido)}</td>\n      <td><a href=\"mailto:${esc(d.email)}\" style=\"color:var(--blue)\">${esc(d.email)}</a></td>\n      <td><span class=\"badge badge-amber\">${esc(d.tipo_usuario)}</span></td>\n      <td><span class=\"badge badge-red\">${d.prestamos_vencidos}</span></td>\n      <td style=\"max-width:250px; white-space:normal; font-size:.72rem; color:var(--ink3)\">${esc(d.libros_pendientes || '—')}</td>\n      <td>${fmtDate(d.vencimiento_mas_antiguo)}</td>\n      <td>\n        <button class=\"btn btn-red\" style=\"padding:.3rem .65rem; font-size:.72rem;\"\n          onclick='banearUsuario(${JSON.stringify(d)})'>\n          🚫 Banear\n        </button>\n      </td>\n    </tr>`).join('');\n  } catch(e) {\n    tbody.innerHTML = `<tr><td colspan=\"7\" class=\"empty\"><big>⚠️</big>${e.message}</td></tr>`;\n  }\n}\n\nasync function banearUsuario(deudor) {\n  if (!confirm(`¿Banear a ${deudor.nombre} ${deudor.apellido}?\\nEsto suspenderá su acceso y generará un correo con Gemini.`)) return;\n\n  toast('Generando correo con Gemini AI…', 'warn', 8000);\n\n  try {\n    const { ok, data } = await apiCall('/api/banear', 'POST', deudor);\n    if (ok && data.ok) {\n      mostrarModalCorreo(data.email_generado, deudor);\n      toast(`${deudor.nombre} baneado. Copia el correo del modal.`, 'ok', 6000);\n      loadDeudores();\n    } else {\n      toast(data.error || 'Error al banear', 'err');\n    }\n  } catch(e) { toast('Error de red: ' + e.message, 'err'); }\n}\n\nfunction mostrarModalCorreo(texto, deudor) {\n  document.getElementById('modal-email-content').textContent = texto || '[Sin respuesta de Gemini]';\n  document.getElementById('modal-overlay').classList.add('visible');\n}\nfunction cerrarModal() { document.getElementById('modal-overlay').classList.remove('visible'); }\nfunction copiarCorreo() {\n  const texto = document.getElementById('modal-email-content').textContent;\n  navigator.clipboard.writeText(texto).then(() => toast('Correo copiado al portapapeles', 'ok'));\n}\n\n/* ── REGISTRAR USUARIO ── */\nfunction livePreviewUsuario() {\n  const obj = { nombre: v('u-nombre'), apellido: v('u-apellido'), email: v('u-email'),\n    tipo_usuario: v('u-tipo'), rfid_tag: v('u-rfid'),\n    max_prestamos: parseInt(v('u-maxprestamos')) || 3, fecha_vigencia: v('u-vigencia') || null };\n  document.getElementById('u-payload-preview').textContent = JSON.stringify(obj, null, 2);\n}\n['u-nombre','u-apellido','u-email','u-tipo','u-rfid','u-maxprestamos','u-vigencia']\n  .forEach(id => document.getElementById(id)?.addEventListener('input', livePreviewUsuario));\n\nasync function registrarUsuario() {\n  const nombre = v('u-nombre'), apellido = v('u-apellido'), rfid_tag = v('u-rfid');\n  if (!nombre || !apellido || !rfid_tag) { toast('Nombre, apellido y RFID son obligatorios', 'err'); return; }\n  if (!/^[A-F0-9]{4,16}$/.test(rfid_tag)) { toast('RFID inválido (hex, 4–16 dígitos)', 'err'); return; }\n  const payload = { nombre, apellido, email: v('u-email'), rfid_tag,\n    tipo_usuario: v('u-tipo'), max_prestamos: parseInt(v('u-maxprestamos')) || 3,\n    fecha_vigencia: v('u-vigencia') || null };\n  try {\n    const { ok, data } = await apiCall('/api/usuarios', 'POST', payload);\n    if (ok && data.ok) { toast(`Usuario ${nombre} ${apellido} registrado`, 'ok'); limpiarFormUsuario(); }\n    else { toast(data.error || 'Error al registrar', 'err'); }\n  } catch(e) { toast('Error de red: ' + e.message, 'err'); }\n}\nfunction limpiarFormUsuario() {\n  ['u-nombre','u-apellido','u-email','u-rfid','u-vigencia'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });\n  document.getElementById('u-tipo').value = 'estudiante';\n  document.getElementById('u-maxprestamos').value = '3';\n  document.getElementById('u-payload-preview').textContent = '—';\n}\n\n/* ── REGISTRAR LIBRO ── */\nlet qrInstance = null;\nfunction getQRCodigo() {\n  const c = v('l-qr'); if (c) return c.trim();\n  const isbn = v('l-isbn').replace(/[-\\s]/g,''); if (isbn) return 'LIB-' + isbn.slice(-5).padStart(5,'0');\n  const t = v('l-titulo'); if (t) return 'LIB-' + Math.abs(hashCode(t)).toString().slice(0,5).padStart(5,'0');\n  return '';\n}\nfunction hashCode(str) { let h=0; for(let i=0;i<str.length;i++) h=Math.imul(31,h)+str.charCodeAt(i)|0; return h; }\n\nfunction previewQR() {\n  const codigo = getQRCodigo();\n  const box = document.getElementById('qr-preview-box');\n  document.getElementById('qr-codigo-label').textContent = codigo || '—';\n  if (!codigo) { box.innerHTML = `<div style=\"width:200px;height:200px;display:grid;place-items:center;color:#aaa;font-size:.75rem;\">Llena el formulario →</div>`; return; }\n  box.innerHTML = '';\n  qrInstance = new QRCode(box, { text: codigo, width: 200, height: 200, colorDark: '#000', colorLight: '#fff', correctLevel: QRCode.CorrectLevel.H });\n}\n\nfunction imprimirQR() {\n  const codigo = getQRCodigo(), titulo = v('l-titulo') || 'Sin título';\n  if (!codigo) { toast('Genera primero el QR', 'warn'); return; }\n  const canvas = document.getElementById('qr-preview-box').querySelector('canvas');\n  const imgSrc = canvas ? canvas.toDataURL() : (document.getElementById('qr-preview-box').querySelector('img')?.src || '');\n  const win = window.open('', '_blank');\n  win.document.write(`<!DOCTYPE html><html><head><title>QR-${titulo}</title><style>body{font-family:monospace;text-align:center;padding:2rem}img{display:block;margin:0 auto 1rem}@media print{button{display:none}}</style></head><body><img src=\"${imgSrc}\" width=\"200\"><h2>${titulo}</h2><p>${codigo}</p><p>${v('l-autor')}</p><br><button onclick=\"window.print()\">🖨 Imprimir</button></body></html>`);\n  win.document.close();\n}\n\nasync function registrarLibro() {\n  const titulo = v('l-titulo'), qr_codigo = getQRCodigo();\n  if (!titulo) { toast('El título es obligatorio', 'err'); return; }\n  if (!qr_codigo) { toast('No se pudo generar el código QR', 'err'); return; }\n  const payload = { titulo, autor: v('l-autor'), isbn: v('l-isbn'), editorial: v('l-editorial'),\n    anio: parseInt(v('l-anio')) || null, ejemplares: parseInt(v('l-ejemplares')) || 1, qr_codigo };\n  try {\n    const { ok, data } = await apiCall('/api/libros', 'POST', payload);\n    if (ok && data.ok) { toast(`\"${titulo}\" registrado`, 'ok'); limpiarFormLibro(); loadCatalogo(); }\n    else { toast(data.error || 'Error al registrar libro', 'err'); }\n  } catch(e) { toast('Error de red: ' + e.message, 'err'); }\n}\n\nfunction limpiarFormLibro() {\n  ['l-titulo','l-autor','l-isbn','l-editorial','l-anio','l-qr'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });\n  document.getElementById('l-ejemplares').value = '1';\n  previewQR();\n}\n\n/* ── MQTT ── */\nfunction initMQTT() {\n  if (mqttClient) { try { mqttClient.disconnect(); } catch {} mqttClient = null; }\n  if (typeof Paho === 'undefined') { setMqttStatus('offline', 'Paho no disponible'); return; }\n  setMqttStatus('connecting', 'Conectando…');\n  mqttClient = new Paho.Client(CFG.mqttHost, CFG.mqttPort, '/mqtt', CFG.mqttClient);\n  mqttClient.onConnectionLost = ({ errorMessage }) => {\n    setMqttStatus('offline', 'Desconectado');\n    toast('MQTT desconectado: ' + errorMessage, 'err');\n    setTimeout(initMQTT, 5000);\n  };\n  mqttClient.onMessageArrived = (msg) => {\n    try {\n      const payload = JSON.parse(msg.payloadString);\n      appendEvent(payload);\n      // Si es un RFID confirmado, activar banner\n      if (payload.tipo === 'rfid_ok' && payload.usuario) {\n        activarRfidBanner(payload.usuario);\n        actualizarBotonPrestar();\n      }\n    } catch { appendEvent({ tipo: 'raw', mensaje: msg.payloadString }); }\n  };\n  mqttClient.connect({\n    onSuccess: () => {\n      setMqttStatus('online', 'MQTT online');\n      mqttClient.subscribe('biblioteca/ui/eventos');\n      mqttClient.subscribe('biblioteca/sistema/status');\n      toast('MQTT conectado', 'ok');\n    },\n    onFailure: ({ errorMessage }) => {\n      setMqttStatus('offline', 'Sin conexión');\n      toast('MQTT error: ' + errorMessage, 'err');\n      setTimeout(initMQTT, 7000);\n    },\n    useSSL: false, timeout: 5\n  });\n}\n\nfunction setMqttStatus(state, label) {\n  document.getElementById('mqtt-dot').className = 'status-dot ' + (state === 'online' ? 'online' : state === 'offline' ? 'offline' : '');\n  document.getElementById('mqtt-label').textContent = label;\n}\nfunction setApiStatus(state) {\n  document.getElementById('api-dot').className = 'status-dot ' + (state === 'online' ? 'online' : state === 'offline' ? 'offline' : '');\n  document.getElementById('api-label').textContent = state === 'online' ? 'API online' : state === 'offline' ? 'API sin respuesta' : 'API…';\n}\n\n/* ── FEED ── */\nconst ICONS = {\n  prestamo: { icon:'📖', cls:'prestamo' }, prestamo_exitoso: { icon:'📖', cls:'prestamo' },\n  devolucion: { icon:'↩️', cls:'devolucion' }, devolucion_exitosa: { icon:'↩️', cls:'devolucion' },\n  devolucion_tardía: { icon:'⏰', cls:'error' }, error: { icon:'✕', cls:'error' },\n  usuario_identificado: { icon:'👤', cls:'usuario' }, rfid_ok: { icon:'🏷️', cls:'usuario' },\n  rfid_desconocido: { icon:'⚠️', cls:'error' }, sistema: { icon:'⚙', cls:'sistema' },\n};\n\nfunction appendEvent(payload) {\n  const feed = document.getElementById('event-feed');\n  if (feed.querySelector('.empty')) feed.innerHTML = '';\n  const tipo  = payload.tipo || 'sistema';\n  const { icon, cls } = ICONS[tipo] || { icon:'●', cls:'sistema' };\n  const ahora = new Date().toLocaleTimeString('es-MX');\n  const titulo = payload.mensaje || payload.error || tipo;\n  const meta = payload.datos\n    ? Object.entries(payload.datos).slice(0,3).map(([k,v2]) => `${k}: ${v2}`).join(' · ')\n    : '';\n  const item = document.createElement('div');\n  item.className = 'event-item';\n  item.innerHTML = `<div class=\"event-icon ${cls}\">${icon}</div>\n    <div class=\"event-body\"><div class=\"event-title\">${esc(titulo)}</div>${meta ? `<div class=\"event-meta\">${esc(meta)}</div>` : ''}</div>\n    <div class=\"event-time\">${ahora}</div>`;\n  feed.prepend(item);\n  while (feed.children.length > 60) feed.removeChild(feed.lastChild);\n  if (['prestamo_exitoso','devolucion_exitosa','devolucion_tardía'].includes(tipo)) setTimeout(loadStats, 800);\n}\n\nfunction clearFeed() {\n  document.getElementById('event-feed').innerHTML = '<div class=\"empty\"><big>📡</big>Feed limpiado…</div>';\n}\n\n/* ── HELPERS ── */\nfunction v(id) { return (document.getElementById(id)?.value || '').trim(); }\nfunction esc(s) { const d = document.createElement('div'); d.textContent = String(s ?? ''); return d.innerHTML; }\nfunction fmtDate(s) {\n  if (!s) return '—';\n  try { return new Date(s).toLocaleDateString('es-MX', { day:'2-digit', month:'short', year:'numeric' }); }\n  catch { return s; }\n}\n\n/* ── INIT ── */\nfillConfigForm();\ninitMQTT();\nloadStats();\nsetInterval(loadStats, 30000);\n</script>\n</body>\n</html>",
