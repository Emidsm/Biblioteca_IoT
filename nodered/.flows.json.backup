                "5ef3ae7ef3a50052"
            ]
        ]
    },
    {
        "id": "5ef3ae7ef3a50052",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Lógica de devolución",
        "func": "\nconst rows = msg.payload;\n\nif (!rows || rows.length === 0) {\n    msg.payload = {\n        ok: false,\n        error: 'PRESTAMO_NO_ENCONTRADO',\n        mensaje: 'No se encontró un préstamo activo para este usuario y libro'\n    };\n    msg.statusCode = 404;\n    return [null, msg];\n}\n\nconst prestamo = rows[0];\nmsg.prestamo_data = prestamo;\n\nconst ahora = new Date().toISOString().replace('T', ' ').substring(0, 19);\n\nmsg.topic = `BEGIN TRANSACTION;\nUPDATE prestamos\n    SET estado = 'devuelto',\n        fecha_devolucion_real = '${ahora}',\n        rfid_devolucion = '${msg.rfid_tag}'\n    WHERE id = ${prestamo.prestamo_id};\nUPDATE ejemplares\n    SET estado = 'disponible'\n    WHERE id = ${prestamo.ejemplar_id};\nINSERT INTO audit_log (tipo, origen, mensaje, payload_raw)\n    VALUES ('devolucion', 'iot',\n        'Devolución registrada: ${prestamo.titulo.replace(/'/g, \"''\")} por ${prestamo.usuario_nombre.replace(/'/g, \"''\")}',\n        '${JSON.stringify({ prestamo_id: prestamo.prestamo_id })}');\nCOMMIT;`;\n\nreturn [msg, null];\n",
        "outputs": 2,
        "x": 1540,
        "y": 340,
        "wires": [
            [
                "9d504d55e914cbb0"
            ],
            [
                "e48f2edadcba6356"
            ]
        ]
    },
    {
        "id": "9d504d55e914cbb0",
        "type": "sqlite",
        "z": "3b6fce683d31f02e",
        "mydb": "7d57faacb03b73be",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "DB: Ejecutar devolución",
        "x": 1780,
