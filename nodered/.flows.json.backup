    {
        "id": "a51981f4f08f261e",
        "type": "http in",
        "z": "3b6fce683d31f02e",
        "name": "GET /api/deudores",
        "url": "/api/deudores",
        "method": "get",
        "x": 140,
        "y": 660,
        "wires": [
            [
                "089ee14890784afe"
            ]
        ]
    },
    {
        "id": "089ee14890784afe",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Query deudores",
        "func": "\nmsg.topic = `\nSELECT\n    u.id AS usuario_id,\n    u.nombre,\n    u.apellido,\n    u.email,\n    u.tipo_usuario,\n    u.rfid_tag,\n    COUNT(p.id) AS prestamos_vencidos,\n    MIN(p.fecha_devolucion_esperada) AS vencimiento_mas_antiguo,\n    GROUP_CONCAT(l.titulo, ' | ') AS libros_pendientes\nFROM prestamos p\nJOIN usuarios u ON p.usuario_id = u.id\nJOIN ejemplares e ON p.ejemplar_id = e.id\nJOIN libros l ON e.libro_id = l.id\nWHERE p.estado = 'activo'\n  AND p.fecha_devolucion_esperada < datetime('now','localtime')\nGROUP BY u.id\nORDER BY prestamos_vencidos DESC, vencimiento_mas_antiguo ASC`;\nreturn msg;\n",
        "outputs": 1,
        "x": 340,
        "y": 660,
        "wires": [
            [
                "1e52532576beddc6"
            ]
        ]
    },
    {
        "id": "1e52532576beddc6",
        "type": "sqlite",
        "z": "3b6fce683d31f02e",
        "mydb": "7d57faacb03b73be",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "DB: Deudores",
