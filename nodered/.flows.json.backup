        "func": "\nconst meta = msg.backup_meta || {};\nmsg.topic = `INSERT INTO audit_log (tipo, origen, mensaje)\n    VALUES ('backup', 'sistema', 'Respaldo ${meta.tipo || ''} completado: ${meta.archivo || ''}');`;\nnode.status({ fill: 'green', shape: 'dot', text: `OK ${meta.timestamp}` });\nnode.log(`Backup completado: ${meta.archivo}`);\nreturn msg;\n",
