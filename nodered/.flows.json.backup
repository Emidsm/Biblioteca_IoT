    {
        "id": "facaf4e58d12b645",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Guardar RFID en flow context",
        "func": "\n// Cuando llega un RFID por MQTT, lo guardamos en flow context\n// para que el dashboard pueda usarlo cuando el usuario seleccione un libro\nconst tag = (msg.payload && msg.payload.rfid_tag)\n    ? msg.payload.rfid_tag\n    : (typeof msg.payload === 'string' ? msg.payload : null);\n\nif (!tag || !/^[A-Fa-f0-9]{4,16}$/.test(tag.trim())) {\n    node.warn('RFID recibido inválido: ' + JSON.stringify(msg.payload));\n    return null;\n}\n\nconst rfidLimpio = tag.trim().toUpperCase();\nflow.set('ultimo_rfid', rfidLimpio);\nflow.set('rfid_ts', new Date().toISOString());\n\n// Consultar el usuario para mostrar en el dashboard\nmsg.topic = `SELECT id, nombre, apellido, tipo_usuario, activo,\n    max_prestamos, fecha_vigencia,\n    (SELECT COUNT(*) FROM prestamos WHERE usuario_id = u.id AND estado = 'activo') AS prestamos_actuales\nFROM usuarios u WHERE rfid_tag = '${rfidLimpio}' LIMIT 1`;\nmsg.rfid_tag = rfidLimpio;\nreturn msg;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 200,
        "wires": [
            [
                "af5c0b1880162ff6"
            ]
        ]
    },
    {
        "id": "af5c0b1880162ff6",
        "type": "sqlite",
        "z": "3b6fce683d31f02e",
        "mydb": "7d57faacb03b73be",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "DB: Lookup usuario por RFID",
        "x": 580,
        "y": 200,
        "wires": [
            [
                "a8f17f46945c67c9"
            ]
        ]
    },
    {
        "id": "a8f17f46945c67c9",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Publicar usuario al dashboard",
        "func": "\nconst rows = msg.payload;\nif (!rows || rows.length === 0) {\n    msg.payload = JSON.stringify({\n        tipo: 'rfid_desconocido',\n        mensaje: 'Tag RFID no registrado: ' + msg.rfid_tag,\n        ok: false\n    });\n} else {\n    const u = rows[0];\n    flow.set('usuario_activo', u);\n    msg.payload = JSON.stringify({\n        tipo: 'rfid_ok',\n        ok: true,\n        usuario: {\n            id: u.id,\n            nombre: u.nombre + ' ' + u.apellido,\n            tipo: u.tipo_usuario,\n            cupo: u.max_prestamos - u.prestamos_actuales\n        },\n        mensaje: `✅ ${u.nombre} ${u.apellido} (${u.tipo_usuario}) — Cupo: ${u.max_prestamos - u.prestamos_actuales}`\n    });\n}\nreturn msg;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 200,
        "wires": [
            [
                "83e2a31a77daa91d"
            ]
        ]
    },
    {
        "id": "b39e8897124d0145",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Wrap MQTT → formato HTTP",
        "func": "\nmsg.req = { headers: { 'x-api-key': 'secreto123' } };\nmsg.res = null;\nmsg._mqtt = true;\nreturn msg;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 130,
        "wires": [
            [
                "8fae7c198084bcdb"
            ]
        ]
    },
    {
        "id": "8fae7c198084bcdb",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Validar API Key",
        "func": "\nconst expectedKey = 'secreto123';\nconst receivedKey = (msg.req && msg.req.headers)\n    ? msg.req.headers['x-api-key']\n    : null;\n\nif (receivedKey !== expectedKey) {\n    node.warn('API Key inválida');\n    msg.payload = { ok: false, error: 'No autorizado' };\n    msg.statusCode = 401;\n    return [null, msg];\n}\n\nmsg.scanData = (typeof msg.payload === 'string')\n    ? JSON.parse(msg.payload)\n    : msg.payload;\n\nreturn [msg, null];\n",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 100,
        "wires": [
            [
                "c21accd504c75dc1"
            ],
            [
                "e48f2edadcba6356"
            ]
        ]
    },
    {
        "id": "c21accd504c75dc1",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Enrutar por tipo de escaneo",
        "func": "\nconst scan = msg.scanData || {};\n\nif (!scan.tipo) {\n    msg.payload = { ok: false, error: 'Payload inválido: falta campo tipo' };\n    msg.statusCode = 400;\n    return [null, null, null, msg];\n}\n\nmsg.origen = scan.origen || 'desconocido';\n\nswitch (scan.tipo) {\n    case 'identificar_usuario':\n        msg.rfid_tag = scan.rfid_tag;\n        return [msg, null, null, null];\n    case 'prestamo':\n        // prestamo ahora puede venir con libro_id en vez de qr_codigo\n        msg.rfid_tag = scan.rfid_tag;\n        msg.libro_id = scan.libro_id || null;\n        msg.qr_codigo = scan.qr_codigo || null;\n        return [null, msg, null, null];\n    case 'devolucion':\n        msg.rfid_tag = scan.rfid_tag;\n        msg.qr_codigo = scan.qr_codigo || null;\n        msg.prestamo_id = scan.prestamo_id || null;\n        return [null, null, msg, null];\n    default:\n        msg.payload = { ok: false, error: `Tipo desconocido: ${scan.tipo}` };\n        msg.statusCode = 400;\n        return [null, null, null, msg];\n}\n",
        "outputs": 4,
        "x": 820,
        "y": 100,
        "wires": [
            [
                "c006843173c857ca"
            ],
            [
                "285403887336d74c"
            ],
            [
                "3c6402c42576caa1"
            ],
            [
                "e48f2edadcba6356"
            ]
        ]
    },
    {
        "id": "c006843173c857ca",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Preparar consulta usuario",
        "func": "\nconst tag = msg.rfid_tag;\n\nif (!tag || typeof tag !== 'string' || tag.trim() === '') {\n    msg.payload = { ok: false, error: 'Tag RFID no válido o vacío' };\n    msg.statusCode = 400;\n    return [null, msg];\n}\n\nif (!/^[A-Fa-f0-9]{4,16}$/.test(tag.trim())) {\n    msg.payload = { ok: false, error: 'Formato de tag RFID inválido' };\n    msg.statusCode = 422;\n    return [null, msg];\n}\n\nconst rfidLimpio = tag.trim().toUpperCase();\n\nmsg.topic = `SELECT id, nombre, apellido, email, tipo_usuario, activo,\n    max_prestamos, fecha_vigencia,\n    (SELECT COUNT(*) FROM prestamos\n     WHERE usuario_id = u.id AND estado = 'activo') AS prestamos_actuales\nFROM usuarios u\nWHERE rfid_tag = '${rfidLimpio}'`;\n\nreturn [msg, null];\n",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1060,
        "y": 60,
        "wires": [
            [
                "53f8bb7588ce47c3"
            ],
            [
                "e48f2edadcba6356"
            ]
        ]
    },
    {
        "id": "53f8bb7588ce47c3",
        "type": "sqlite",
        "z": "3b6fce683d31f02e",
        "mydb": "7d57faacb03b73be",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "DB: Buscar usuario por RFID",
        "x": 1340,
        "y": 40,
        "wires": [
            [
                "15bf6bf737757f88"
            ]
        ]
    },
    {
        "id": "15bf6bf737757f88",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Procesar respuesta usuario",
        "func": "\nconst rows = msg.payload;\n\nif (!rows || rows.length === 0) {\n    node.warn(`RFID no registrado: ${msg.rfid_tag}`);\n    msg.payload = { ok: false, tipo: 'error', mensaje: 'Tag RFID no encontrado', rfid_tag: msg.rfid_tag };\n    msg.statusCode = 404;\n    return [msg, null];\n}\n\nconst usuario = rows[0];\n\nif (!usuario.activo) {\n    msg.payload = { ok: false, tipo: 'error', mensaje: `El usuario ${usuario.nombre} está inactivo` };\n    msg.statusCode = 403;\n    return [msg, null];\n}\n\nif (usuario.fecha_vigencia && new Date(usuario.fecha_vigencia) < new Date()) {\n    msg.payload = { ok: false, tipo: 'error', mensaje: `Membresía vencida de ${usuario.nombre}` };\n    msg.statusCode = 403;\n    return [msg, null];\n}\n\nmsg.usuario = usuario;\nmsg.payload = {\n    ok: true,\n    tipo: 'usuario_identificado',\n    mensaje: `Lector: ${usuario.nombre} ${usuario.apellido}`,\n    datos: {\n        Perfil: usuario.tipo_usuario,\n        Cupo: `${usuario.prestamos_actuales} de ${usuario.max_prestamos} libros`\n    },\n    usuario: {\n        id: usuario.id,\n        tipo: usuario.tipo_usuario,\n        cupo_disponible: usuario.max_prestamos - usuario.prestamos_actuales\n    }\n};\nmsg.statusCode = 200;\nreturn [null, msg];\n",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1640,
        "y": 40,
        "wires": [
            [
                "e48f2edadcba6356"
            ],
            [
                "0ba8007de4005708",
                "8e789b739b905413",
                "83e2a31a77daa91d"
            ]
        ]
    },
    {
        "id": "285403887336d74c",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Validar datos préstamo",
        "func": "\n// Acepta:\n//   a) rfid_tag + libro_id  (nueva ruta web catalog)\n//   b) rfid_tag + qr_codigo (ruta legacy / compatibilidad)\nconst { rfid_tag, libro_id, qr_codigo } = msg;\n\nif (!rfid_tag) {\n    msg.payload = { ok: false, error: 'DATOS_INCOMPLETOS', mensaje: 'Se requiere rfid_tag' };\n    msg.statusCode = 400;\n    return [null, msg];\n}\nif (!libro_id && !qr_codigo) {\n    msg.payload = { ok: false, error: 'DATOS_INCOMPLETOS', mensaje: 'Se requiere libro_id o qr_codigo' };\n    msg.statusCode = 400;\n    return [null, msg];\n}\n\nif (!/^[A-Fa-f0-9]{4,16}$/.test(rfid_tag.trim())) {\n    msg.payload = { ok: false, error: 'RFID_INVALIDO', mensaje: 'Formato de RFID inválido' };\n    msg.statusCode = 422;\n    return [null, msg];\n}\n\nconst rfidLimpio = rfid_tag.trim().toUpperCase();\nmsg.rfid_tag = rfidLimpio;\n\nlet libroWhere = '';\nif (libro_id) {\n    libroWhere = `l.id = ${parseInt(libro_id)}`;\n} else {\n    const qrLimpio = qr_codigo.trim();\n    msg.qr_codigo = qrLimpio;\n    libroWhere = `l.qr_codigo = '${qrLimpio}'`;\n}\n\nmsg.topic = `\nSELECT\n    u.id AS usuario_id,\n    u.nombre || ' ' || u.apellido AS usuario_nombre,\n    u.activo AS usuario_activo,\n    u.fecha_vigencia,\n    u.max_prestamos,\n    (SELECT COUNT(*) FROM prestamos\n     WHERE usuario_id = u.id AND estado = 'activo') AS prestamos_actuales,\n    l.id AS libro_id,\n    l.titulo,\n    l.autor,\n    l.qr_codigo,\n    e.id AS ejemplar_id,\n    e.estado AS ejemplar_estado\nFROM usuarios u, libros l\nLEFT JOIN ejemplares e ON e.libro_id = l.id AND e.estado = 'disponible'\nWHERE u.rfid_tag = '${rfidLimpio}' AND ${libroWhere}\nLIMIT 1`;\n\nreturn [msg, null];\n",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1060,
        "y": 200,
        "wires": [
            [
                "2277ae9b817d92c9"
            ],
            [
                "e48f2edadcba6356"
            ]
        ]
    },
    {
        "id": "2277ae9b817d92c9",
        "type": "sqlite",
        "z": "3b6fce683d31f02e",
        "mydb": "7d57faacb03b73be",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "DB: Verificar disponibilidad",
        "x": 1300,
        "y": 200,
        "wires": [
            [
                "437a1b18b82f7402"
            ]
        ]
    },
    {
        "id": "437a1b18b82f7402",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Lógica de préstamo",
        "func": "\nconst rows = msg.payload;\n\nif (!rows || rows.length === 0) {\n    msg.payload = { ok: false, error: 'TAG_NO_REGISTRADO', mensaje: 'RFID no encontrado' };\n    msg.statusCode = 404;\n    return [null, msg];\n}\n\nconst data = rows[0];\n\nif (!data.libro_id) {\n    msg.payload = { ok: false, error: 'LIBRO_NO_ENCONTRADO', mensaje: 'El libro no existe en el catálogo' };\n    msg.statusCode = 404;\n    return [null, msg];\n}\n\nif (!data.usuario_activo) {\n    msg.payload = { ok: false, error: 'USUARIO_INACTIVO', mensaje: 'Usuario inactivo' };\n    msg.statusCode = 403;\n    return [null, msg];\n}\n\nif (data.fecha_vigencia && new Date(data.fecha_vigencia) < new Date()) {\n    msg.payload = { ok: false, error: 'MEMBRESIA_VENCIDA', mensaje: 'Membresía vencida' };\n    msg.statusCode = 403;\n    return [null, msg];\n}\n\nif (data.prestamos_actuales >= data.max_prestamos) {\n    msg.payload = {\n        ok: false,\n        error: 'CUPO_AGOTADO',\n        mensaje: `${data.usuario_nombre} ya tiene ${data.prestamos_actuales}/${data.max_prestamos} préstamos activos`\n    };\n    msg.statusCode = 409;\n    return [null, msg];\n}\n\nif (data.ejemplar_estado !== 'disponible' || !data.ejemplar_id) {\n    msg.payload = {\n        ok: false,\n        error: 'SIN_EJEMPLARES',\n        mensaje: `\"${data.titulo}\" no tiene ejemplares disponibles`\n    };\n    msg.statusCode = 409;\n    return [null, msg];\n}\n\nmsg.prestamo_data = data;\n\nconst diasPrestamo = 14;\nconst devolucion = new Date();\ndevolucion.setDate(devolucion.getDate() + diasPrestamo);\nmsg.fecha_devolucion = devolucion.toISOString().replace('T', ' ').substring(0, 19);\n\nconst qrVal = data.qr_codigo || msg.qr_codigo || '';\nconst rfidVal = msg.rfid_tag || '';\n\nmsg.topic = `BEGIN TRANSACTION;\nUPDATE ejemplares SET estado = 'prestado' WHERE id = ${data.ejemplar_id};\nINSERT INTO prestamos\n    (usuario_id, ejemplar_id, fecha_devolucion_esperada, estado, rfid_prestamo, qr_prestamo)\nVALUES\n    (${data.usuario_id}, ${data.ejemplar_id}, '${msg.fecha_devolucion}', 'activo',\n     '${rfidVal}', '${qrVal}');\nINSERT INTO audit_log (tipo, origen, usuario_id, ejemplar_id, mensaje, payload_raw)\nVALUES ('prestamo', 'web_catalog', ${data.usuario_id}, ${data.ejemplar_id},\n    'Préstamo registrado: ${data.titulo.replace(/'/g, \"''\")}', '${JSON.stringify({rfid: rfidVal, libro_id: data.libro_id})}');\nCOMMIT;`;\n\nreturn [msg, null];\n",
        "outputs": 2,
        "x": 1540,
        "y": 200,
        "wires": [
            [
                "2a09deb81dbbd2d9"
            ],
            [
                "e48f2edadcba6356"
            ]
        ]
    },
    {
        "id": "2a09deb81dbbd2d9",
        "type": "sqlite",
        "z": "3b6fce683d31f02e",
        "mydb": "7d57faacb03b73be",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "DB: Ejecutar transacción préstamo",
        "x": 1780,
        "y": 200,
        "wires": [
            [
                "10400e58ddcf5f23"
            ]
        ]
    },
    {
        "id": "10400e58ddcf5f23",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Confirmar préstamo",
        "func": "\nconst data = msg.prestamo_data;\n\nmsg.payload = {\n    ok: true,\n    tipo: 'prestamo_exitoso',\n    mensaje: `Préstamo: ${data.titulo}`,\n    datos: {\n        Usuario: data.usuario_nombre,\n        Vence: msg.fecha_devolucion.substring(0, 10)\n    },\n    prestamo: {\n        usuario: data.usuario_nombre,\n        libro: data.titulo,\n        autor: data.autor,\n        ejemplar_id: data.ejemplar_id,\n        fecha_devolucion_esperada: msg.fecha_devolucion\n    }\n};\nmsg.statusCode = 201;\nreturn msg;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 2000,
        "y": 200,
        "wires": [
            [
                "8e789b739b905413",
                "83e2a31a77daa91d",
                "0ba8007de4005708"
            ]
        ]
    },
    {
        "id": "3c6402c42576caa1",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Validar datos devolución",
        "func": "\nconst { rfid_tag, qr_codigo, prestamo_id } = msg;\n\nif (!rfid_tag) {\n    msg.payload = { ok: false, error: 'DATOS_INCOMPLETOS', mensaje: 'Se requiere rfid_tag' };\n    msg.statusCode = 400;\n    return [null, msg];\n}\n\nconst rfidLimpio = rfid_tag.trim().toUpperCase();\nmsg.rfid_tag = rfidLimpio;\n\nlet whereClause = '';\nif (prestamo_id) {\n    whereClause = `p.id = ${parseInt(prestamo_id)} AND u.rfid_tag = '${rfidLimpio}'`;\n} else if (qr_codigo) {\n    const qrLimpio = qr_codigo.trim();\n    whereClause = `u.rfid_tag = '${rfidLimpio}' AND l.qr_codigo = '${qrLimpio}'`;\n} else {\n    msg.payload = { ok: false, error: 'DATOS_INCOMPLETOS', mensaje: 'Se requiere qr_codigo o prestamo_id' };\n    msg.statusCode = 400;\n    return [null, msg];\n}\n\nmsg.topic = `\nSELECT\n    p.id AS prestamo_id,\n    p.ejemplar_id,\n    p.fecha_prestamo,\n    p.fecha_devolucion_esperada,\n    u.nombre || ' ' || u.apellido AS usuario_nombre,\n    l.titulo,\n    l.autor,\n    CASE WHEN p.fecha_devolucion_esperada < datetime('now','localtime') THEN 1 ELSE 0 END AS vencido\nFROM prestamos p\nJOIN usuarios   u ON p.usuario_id  = u.id\nJOIN ejemplares e ON p.ejemplar_id = e.id\nJOIN libros     l ON e.libro_id    = l.id\nWHERE ${whereClause}\n  AND p.estado = 'activo'\nLIMIT 1`;\n\nreturn [msg, null];\n",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1060,
        "y": 340,
        "wires": [
            [
                "07745610afa857a5"
            ],
            [
                "e48f2edadcba6356"
            ]
        ]
    },
    {
        "id": "07745610afa857a5",
        "type": "sqlite",
        "z": "3b6fce683d31f02e",
        "mydb": "7d57faacb03b73be",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "DB: Buscar préstamo activo",
        "x": 1300,
        "y": 340,
        "wires": [
