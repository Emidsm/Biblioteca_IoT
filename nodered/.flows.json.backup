        "id": "fn_format_stats",
        "type": "function",
        "z": "tab_biblioteca_iot",
        "name": "Formatear stats",
        "func": "// La consulta múltiple devuelve array de resultados\nconst results = Array.isArray(msg.payload) ? msg.payload : [msg.payload];\nmsg.payload = {\n    ok: true,\n    timestamp: new Date().toISOString(),\n    estadisticas: results[0] && results[0][0] ? results[0][0] : {},\n    prestamos_activos: results[1] || []\n};\nmsg.statusCode = 200;\nreturn msg;",
