    {
        "id": "8e1ee082ddd70d7c",
        "type": "http in",
        "z": "3b6fce683d31f02e",
        "name": "POST /api/banear",
        "url": "/api/banear",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 140,
        "y": 720,
        "wires": [
            [
                "a2fcaaa6e7a83de8"
            ]
        ]
    },
    {
        "id": "a2fcaaa6e7a83de8",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Preparar baneo",
        "func": "\nconst d = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\n\nif (!d || !d.usuario_id) {\n    msg.payload = { ok: false, error: 'usuario_id requerido' };\n    msg.statusCode = 400;\n    return [null, msg];\n}\n\nmsg.ban_data = d;\n\n// Construir prompt para Gemini\nconst diasDeuda = d.vencimiento_mas_antiguo\n    ? Math.ceil((new Date() - new Date(d.vencimiento_mas_antiguo)) / 86400000)\n    : '?';\n\nmsg.gemini_prompt = `Eres el sistema de la Biblioteca Universitaria BiblioSys.\nRedacta un correo electrónico formal pero con un tono memorable (puede tener un poco de dramatismo cortés) notificando al usuario que su acceso ha sido SUSPENDIDO por préstamos vencidos.\n\nDatos del usuario:\n- Nombre: ${d.nombre} ${d.apellido}\n- Tipo de usuario: ${d.tipo_usuario}\n- Email: ${d.email}\n- Libros pendientes: ${d.libros_pendientes || 'no especificados'}\n- Préstamos vencidos: ${d.prestamos_vencidos}\n- Días de atraso máximo: ${diasDeuda} días\n\nEl correo debe:\n1. Saludar formalmente usando el nombre completo\n2. Mencionar específicamente los libros que no ha devuelto\n3. Indicar que el acceso está suspendido hasta regularizar\n4. Dar instrucciones claras para reactivar (devolver libros en biblioteca)\n5. Firmar como \"Sistema BiblioSys - Biblioteca Universitaria\"\n\nSolo devuelve el correo, sin explicaciones adicionales.`;\n\nreturn [msg, null];\n",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 720,
        "wires": [
            [
                "82dc34cfd4b2f4fc"
            ],
            [
                "e48f2edadcba6356"
            ]
        ]
    },
    {
        "id": "82dc34cfd4b2f4fc",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Llamar API Gemini",
        "func": "\n// Llamada a Gemini Flash 2.0 para generar el mensaje de baneo\n// La API key se lee de variable de entorno GEMINI_API_KEY\nconst apiKey = env.get('GEMINI_API_KEY') || '';\n\nif (!apiKey) {\n    node.warn('GEMINI_API_KEY no configurada en variables de entorno de Node-RED');\n    msg.gemini_texto = '[Error: GEMINI_API_KEY no configurada. Configúrala en Settings > Environment Variables]';\n    return msg; // Continúa sin Gemini para no bloquear el baneo\n}\n\nconst prompt = msg.gemini_prompt;\nconst url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${apiKey}`;\n\n// Usamos un nodo function con fetch async\nconst body = JSON.stringify({\n    contents: [{ parts: [{ text: prompt }] }],\n    generationConfig: { temperature: 0.8, maxOutputTokens: 600 }\n});\n\ntry {\n    const response = await fetch(url, {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: body\n    });\n    const data = await response.json();\n    if (data.candidates && data.candidates[0]) {\n        msg.gemini_texto = data.candidates[0].content.parts[0].text;\n    } else {\n        msg.gemini_texto = '[Gemini no devolvió respuesta: ' + JSON.stringify(data.error || data) + ']';\n    }\n} catch(e) {\n    msg.gemini_texto = '[Error llamando Gemini: ' + e.message + ']';\n    node.error('Gemini error: ' + e.message);\n}\n\nreturn msg;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 720,
        "wires": [
            [
                "96d13ac2464ca81f"
            ]
        ]
    },
    {
        "id": "96d13ac2464ca81f",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Ejecutar baneo en DB",
        "func": "\nconst d = msg.ban_data;\nconst correoGenerado = msg.gemini_texto || '';\n\n// Desactivar usuario y registrar en audit_log\nmsg.topic = `BEGIN TRANSACTION;\nUPDATE usuarios SET activo = 0 WHERE id = ${d.usuario_id};\nINSERT INTO audit_log (tipo, origen, usuario_id, mensaje, payload_raw)\nVALUES ('baneo', 'api', ${d.usuario_id},\n    'Usuario baneado por préstamos vencidos. Email generado con Gemini enviado a ${(d.email||'').replace(/'/g,\"''\")}',\n    '${JSON.stringify({prestamos_vencidos: d.prestamos_vencidos, libros: d.libros_pendientes}).replace(/'/g, \"''\")}');\nCOMMIT;`;\n\nmsg.correo_gemini = correoGenerado;\nmsg.ban_usuario = d;\nreturn msg;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 720,
        "wires": [
            [
                "7ae48a5f4c10312b"
            ]
        ]
    },
    {
        "id": "7ae48a5f4c10312b",
        "type": "sqlite",
        "z": "3b6fce683d31f02e",
        "mydb": "7d57faacb03b73be",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "DB: Ejecutar baneo",
        "x": 1020,
        "y": 720,
        "wires": [
            [
                "8b42c8c85d0e84c9"
            ]
        ]
    },
    {
        "id": "8b42c8c85d0e84c9",
        "type": "function",
        "z": "3b6fce683d31f02e",
        "name": "Respuesta baneo",
        "func": "\nconst d = msg.ban_usuario;\nmsg.payload = {\n    ok: true,\n    mensaje: `Usuario ${d.nombre} ${d.apellido} baneado correctamente`,\n    email_generado: msg.correo_gemini,\n    usuario: d\n};\nmsg.statusCode = 200;\nreturn msg;\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1220,
        "y": 720,
        "wires": [
            [
                "8e789b739b905413"
            ]
        ]
    },
    {
        "id": "0875ca6391896448",
        "type": "http in",
        "z": "3b6fce683d31f02e",
        "name": "POST /api/prestamo/web",
        "url": "/api/prestamo/web",
        "method": "post",
        "upload": false,
        "swaggerDoc": "",
        "x": 140,
